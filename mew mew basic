    if launchConfig and type(launchConfig.gifts) == "table" then
        for _, id in ipairs(giftOptions) do
            if table.find(launchConfig.gifts, id) then
                table.insert(initialGifts, id)
            end
        end
    end

    local function setGiftSelection(values)
        local feature = features.AutoOpenGifts
        if feature then
            feature.setSelection(values)
        end
    end

    automatic:CreateDropdown({
        name = "Gifts",
        flag = "AutoOpenGiftTypes",
        options = giftOptions,
        multiSelect = true,
        value = initialGifts,
        callback = setGiftSelection,
    })
    if launchConfig then
        setGiftSelection(initialGifts)
    end
    createToggle(automatic, "🎀 auto open gifts", "AutoOpenGifts")

    settings:CreateSection({ name = "Preferences" })
    settings:CreateInput({
        name = "Hub Name",
        flag = "HubName",
        value = "Kaitun Mew Mew Hub",
        placeholder = "Kaitun Mew Mew Hub",
    })
    settings:CreateToggle({
        name = "✨ Enable Anti-AFK",
        flag = "AntiAFK",
        value = true,
        callback = function(enabled)
            if enabled then
                if environment.RobloxHubAntiAfkJob then
                    pcall(task.cancel, environment.RobloxHubAntiAfkJob)
                end
                environment.RobloxHubAntiAfkJob = task.spawn(function()
                    local player = game:GetService("Players").LocalPlayer
                    while true do
                        task.wait(12 * 60)
                        local character = player.Character
                        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                        if humanoid and humanoid.Health > 0 then
                            humanoid.Jump = true
                        end
                    end
                end)
            else
                if environment.RobloxHubAntiAfkJob then
                    pcall(task.cancel, environment.RobloxHubAntiAfkJob)
                    environment.RobloxHubAntiAfkJob = nil
                end
            end
        end,
    })
end

for _, start in ipairs(startupActions) do
    start()
end

if environment.RobloxHubAntiAfkJob then
    pcall(task.cancel, environment.RobloxHubAntiAfkJob)
end
environment.RobloxHubAntiAfkJob = task.spawn(function()
    local player = game:GetService("Players").LocalPlayer
    while true do
        task.wait(12 * 60)
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.Health > 0 then
            humanoid.Jump = true
        end
    end
end)
