    body.Parent = main

    local function addCard(label, y)
        local card = Instance.new("Frame")
        card.Size = UDim2.new(1, -12, 0, 48)
        card.Position = UDim2.new(0, 6, 0, y)
        card.BackgroundColor3 = Color3.fromRGB(45, 32, 60)
        card.BorderSizePixel = 0
        card.Parent = body

        local cardCorner = Instance.new("UICorner")
        cardCorner.CornerRadius = UDim.new(0, 14)
        cardCorner.Parent = card

        local mark = Instance.new("Frame")
        mark.Size = UDim2.new(0, 6, 0, 24)
        mark.Position = UDim2.new(0, 14, 0.5, -12)
        mark.BackgroundColor3 = Color3.fromRGB(255, 150, 206)
        mark.BorderSizePixel = 0
        mark.Parent = card

        local markCorner = Instance.new("UICorner")
        markCorner.CornerRadius = UDim.new(0, 6)
        markCorner.Parent = mark

        local titleCard = Instance.new("TextLabel")
        titleCard.Size = UDim2.new(1, -90, 1, 0)
        titleCard.Position = UDim2.new(0, 30, 0, 0)
        titleCard.BackgroundTransparency = 1
        titleCard.Text = label
        titleCard.Font = Enum.Font.GothamSemibold
        titleCard.TextSize = 14
        titleCard.TextColor3 = Color3.fromRGB(255, 255, 255)
        titleCard.TextXAlignment = Enum.TextXAlignment.Left
        titleCard.Parent = card

        local switch = Instance.new("TextButton")
        switch.Size = UDim2.new(0, 52, 0, 24)
        switch.Position = UDim2.new(1, -64, 0.5, -12)
        switch.BackgroundColor3 = Color3.fromRGB(255, 106, 180)
        switch.Text = "ON"
        switch.Font = Enum.Font.GothamBold
        switch.TextSize = 11
        switch.TextColor3 = Color3.fromRGB(255, 255, 255)
        switch.BorderSizePixel = 0
        switch.Parent = card

        local switchCorner = Instance.new("UICorner")
        switchCorner.CornerRadius = UDim.new(0, 12)
        switchCorner.Parent = switch

        local state = true
        switch.MouseButton1Click:Connect(function()
            state = not state
            switch.Text = state and "ON" or "OFF"
            switch.BackgroundColor3 = state and Color3.fromRGB(255, 106, 180) or Color3.fromRGB(81, 74, 106)
        end)

        return card
    end

    local sections = {
        "Farm",
        "Optimize",
        "Mail",
        "Rank",
        "Auto",
        "Settings",
    }

    local y = 0
    for _, label in ipairs(sections) do
        addCard(label, y)
        y += 58
    end

    local drag = Instance.new("TextButton")
    drag.Size = UDim2.new(1, 0, 0, 100)
    drag.Position = UDim2.new(0, 0, 0, 0)
    drag.BackgroundTransparency = 1
    drag.Text = ""
    drag.Parent = top

    local dragging = false
    local dragStart
    local startPos
    drag.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
        end
    end)
    drag.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseButton1 then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    drag.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    close.MouseButton1Click:Connect(function()
        screenGui:Destroy()
    end)

    return screenGui
end

local window = nil
if Rayfield then
    window = Rayfield:CreateWindow({
        name = "Kaitun Mew Mew Hub",
        sidebarLayout = true,
        configuration = {
            autoSave = launchConfig == nil,
            autoLoad = launchConfig == nil,
            fileName = "MewMewHubUI",
        },
    })
else
    createFallbackGui()
end

if window then
    local main = window:CreateTab({ name = "Mew Home" })
    local farm = window:CreateTab({ name = "Mew Farm" })
    local optimize = window:CreateTab({ name = "Mew Optimize" })
    local eventTab = window:CreateTab({ name = "Mew Event" })
    local mail = window:CreateTab({ name = "Mew Mail" })
    local trading = window:CreateTab({ name = "Mew Trade" })
    local rank = window:CreateTab({ name = "Mew Rank" })
    local automatic = window:CreateTab({ name = "Mew Auto" })
    local settings = window:CreateTab({ name = "Mew Settings" })

    local function createToggle(tab, name, flag)
        local initial = launchToggles[flag] == true
        local applied = false
        local function apply(enabled)
            local feature = features[flag]
            if feature and (not launchConfig or applied ~= enabled) then
                applied = enabled
                feature.duy(enabled, features)
            end
        end

        tab:CreateToggle({
            name = name,
            flag = flag,
            value = initial,
            callback = apply,
        })

        if initial then
            table.insert(startupActions, function()
                apply(true)
            end)
        end
    end

    main:CreateSection({ name = "Quick Start" })
    createToggle(main, "🐾 inf pet speed", "FarmInfinityPetSpeed")
    createToggle(main, "⚡ fast farm", "FarmFastFarm")
    createToggle(main, "✨ auto tap", "FarmAutoTap")
    createToggle(main, "💎 auto claim orb", "FarmAutoCollectOrb")
    createToggle(main, "📍 tele to best area", "FarmTeleToBestArea")
    createToggle(main, "🌍 tele to best world", "FarmTeleToBestWorld")

    farm:CreateSection({ name = "Farming" })
    createToggle(farm, "🐾 inf pet speed", "FarmInfinityPetSpeed")
    createToggle(farm, "⚡ fast farm", "FarmFastFarm")
    createToggle(farm, "✨ auto tap", "FarmAutoTap")
    createToggle(farm, "💎 auto claim orb, lootbox", "FarmAutoCollectOrb")
    createToggle(farm, "📍 tele to best area", "FarmTeleToBestArea")
    createToggle(farm, "🌍 tele to best world", "FarmTeleToBestWorld")
