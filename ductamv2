H.TombstoneBridge = {
    onEvent = function(ev, d)
        R.known = R.known or {}
        local me = (nightState() or {}).me
        if ev == "start" then
            R.progress = R.progress or 0
            R.rowSince = os.clock()
        elseif ev == "progress" then
            R.progress = tonumber(d.row) or R.progress
            R.rowSince = os.clock()
            R.mustMoveBy = nil
        elseif ev == "RowState" then
            if (d.state == "cracking" or d.state == "fallen") and d.row and d.lane then
                R.known[tonumber(d.row)] = (tonumber(d.lane) == 1) and 2 or 1
                if R.seen then R.seen[tostring(d.row) .. ":" .. tostring(d.lane)] = nil end
            end
        elseif ev == "lantern" or ev == "LuckGlimmer" then
            if d.row and d.lane then R.known[tonumber(d.row)] = tonumber(d.lane) end
        elseif ev == "Shake" or ev == "Collapse" then
            local cur = R.progress or 0
            for _, row in ipairs(type(d.list) == "table" and d.list or {}) do
                if tonumber(row) == cur then
                    local at = tonumber(d.at)
                    R.mustMoveBy = ev == "Collapse" and (serverNow() + 0.4) or (at or (serverNow() + 1.5))
                end
            end
        elseif ev == "caught" and d.id and d.id ~= me then
            R.dead = R.dead or {}
            R.dead[tonumber(d.id) or d.id] = true
        elseif ev == "Finished" and d.id == me then
            R.done = true
        end
    end,
    tick = function()
        if R.done then setControls(true) return end
        local arena = arenaModel()
        local bridge = arena and arena:FindFirstChild("Bridge")
        local p = playerPos()
        if not (bridge and p) then return end
        R.progress = R.progress or 0
        R.known = R.known or {}
        R.playerConfirmed = R.playerConfirmed or {}
        local nextRow = R.progress + 1
        local row = bridge:FindFirstChild("Row" .. nextRow)
        if not row then
            local endP = arena:FindFirstChild("EndPlatform")
            local pos = partPos(endP)
            if pos then
                local size = endP:IsA("BasePart") and endP.Size or Vector3.new(27, 1, 29)
                local toward = Vector3.new(0, 0, (p.Z > pos.Z) and 1 or -1)
                local target = Vector3.new(pos.X, p.Y, pos.Z) + toward * math.max(0, size.Z / 2 - 5)
                setControls(false)
                moveTo(target)
                local h = humanoid()
                local flatDir = Vector3.new(target.X - p.X, 0, target.Z - p.Z)
                flatDir = flatDir.Magnitude > 0.1 and flatDir.Unit or Vector3.new(0, 0, -1)
                R.endSince = R.endSince or os.clock()
                local atEdge = atStoneEdge(p, flatDir) or edgeAhead(p, flatDir)
                if h and h.FloorMaterial ~= Enum.Material.Air and os.clock() - (R.lastJump or 0) > 1.4 and atEdge then
                    R.lastJump = os.clock()
                    R.endSince = os.clock()
                    h:Move(flatDir, false)
                    task.wait(0.04)
                    h.Jump = true
                    roundLog("bridge jump to the end platform (edge)")
                end
            end
            state.gamesNote = "Tombstone Bridge: walking to the end"
            return
        end

        R.seen = R.seen or {}
        R.lastOn = R.lastOn or {}
        local now = os.clock()
        local roots = {}
        local contestants = isfn(G.HGNight, "Contestants") and gval(G.HGNight.Contestants) or nil
        local deadUsers = {}
        R.dead = R.dead or {}
        for id, c in pairs(type(contestants) == "table" and contestants or {}) do
            if type(c) == "table" then
                if not R.fieldsLogged then
                    R.fieldsLogged = true
                    roundLog("contestant record %s", compact(c))
                end
                local uid = tonumber(c.UserId or c.userId or c.User or c.Player)
                if c.Alive == false or c.Ghost == true or R.dead[id] then
                    if uid then deadUsers[uid] = true end
                    if type(c.Name) == "string" then deadUsers[c.Name] = true end
                end
            end
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and not deadUsers[plr.UserId] and not deadUsers[plr.Name] then
                local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
                if root and not (hum and hum.Health <= 0) then roots[#roots + 1] = { key = "p" .. plr.UserId, pos = root.Position } end
            end
        end
        for id in pairs(type(contestants) == "table" and contestants or {}) do
            if type(id) == "number" and id < 0 and not R.dead[id] then
                local root = contestantRoot(id)
                if root then roots[#roots + 1] = { key = "b" .. id, pos = root.Position } end
            end
        end
        local endP = arena:FindFirstChild("EndPlatform")
        local endPos = partPos(endP)
        local endSize = (endP and endP:IsA("BasePart")) and endP.Size or Vector3.new(27, 1, 29)
        local function stoneAt(rp)
            for r = math.max(1, nextRow - 1), nextRow + 5 do
                local rowModel = bridge:FindFirstChild("Row" .. r)
                if not rowModel then
                    if endPos and math.abs(rp.X - endPos.X) <= endSize.X / 2 and math.abs(rp.Z - endPos.Z) <= endSize.Z / 2 then
                        return r, 0, endPos
                    end
                    break
                end
                for l = 1, 2 do
                    local sp = rowModel and partPos(rowModel:FindFirstChild("Stone" .. l))
                    if sp and math.abs(rp.X - sp.X) <= 4.5 and math.abs(rp.Z - sp.Z) <= 4.5 then
                        return r, l, sp
                    end
                end
            end
            return nil
        end
        local function markSafe(r, l, why)
            R.playerConfirmed[r] = l
            if not R.known[r] then
                R.known[r] = l
                log("Tombstone Bridge: row %d lane %d is safe (%s)", r, l, why)
                roundLog("bridge: row %d lane %d safe (%s)", r, l, why)
            end
        end
        local function markBad(r, l, why)
            local other = l == 1 and 2 or 1
            if R.known[r] ~= other then
                R.known[r] = other
                log("Tombstone Bridge: row %d lane %d is bad (%s), taking lane %d", r, l, why, other)
                roundLog("bridge: row %d lane %d bad (%s)", r, l, why)
            end
        end
        for _, e in ipairs(roots) do
            local r, l, sp = stoneAt(e.pos)
            if r then
                local dy = e.pos.Y - sp.Y
                if dy < -2 then
                    markBad(r, l, "someone fell through it")
                elseif dy > 1.5 and dy < 5.5 then
                    local last = R.lastOn[e.key]
                    if last and last.row == r - 1 and r - 1 >= 1 and last.lane > 0 and now - last.since >= 0.25 and last.samples >= 2 then
                        markSafe(last.row, last.lane, string.format("%s stood %.1fs on it then %s", e.key, now - last.since, l == 0 and "reached the end" or "crossed"))
                    end
                    if not last or last.row ~= r or last.lane ~= l then
                        R.lastOn[e.key] = { row = r, lane = l, since = now, samples = 1 }
                    else
                        last.samples += 1
                    end
                    if l > 0 then
                        local key = r .. ":" .. l
                        R.seen[key] = R.seen[key] or now
                        if now - R.seen[key] >= 3 then markSafe(r, l, e.key .. " stood on it for 3 s") end
                    end
                end
            end
        end
        for key, t in pairs(R.seen) do
            local alive = false
            for _, e in ipairs(roots) do
                local r, l = stoneAt(e.pos)
                if r and (r .. ":" .. l) == key and e.pos.Y > 0 then alive = true break end
            end
            if not alive then R.seen[key] = nil end
        end
        local lane = R.playerConfirmed[nextRow]
        local waited = os.clock() - (R.rowSince or os.clock())
        if not lane then
            if waited > 1.5 and not R.lanternAsked then
                R.lanternAsked = os.clock()
            end
            local mustMove = R.mustMoveBy and serverNow() >= R.mustMoveBy - 0.5
            state.gamesNote = string.format("Tombstone Bridge: row %d, waiting for a confirmed safe stone (%ds)", nextRow, math.floor(waited))
            return
        end
        R.lanternAsked = nil

        local stone = row:FindFirstChild("Stone" .. lane)
        local pos = partPos(stone)
        if not pos then return end
        setControls(false)
        local h = humanoid()
        local target = Vector3.new(pos.X, p.Y, pos.Z)
        local flat = Vector3.new(p.X - pos.X, 0, p.Z - pos.Z).Magnitude
        if R.stepKey ~= nextRow .. ":" .. lane then
            R.stepKey = nextRow .. ":" .. lane
            R.stepSince = os.clock()
            R.jumped = false
        end
        moveTo(target)

        local flatDir = Vector3.new(pos.X - p.X, 0, pos.Z - p.Z)
        flatDir = flatDir.Magnitude > 0.1 and flatDir.Unit or Vector3.new(0, 0, -1)
        local grounded = h and h.FloorMaterial ~= Enum.Material.Air
        local atEdge = atStoneEdge(p, flatDir) or edgeAhead(p, flatDir)
        if h and grounded and flat > 1.5 and os.clock() - (R.lastJump or 0) > 1.4 and atEdge then
            R.lastJump = os.clock()
            R.stepSince = os.clock()
            h:Move(flatDir, false)
            task.wait(0.04)
            h.Jump = true
            roundLog("bridge jump to row %d lane %d (edge)", nextRow, lane)
        end
        state.gamesNote = string.format("Tombstone Bridge: row %d lane %d, %s", nextRow, lane, flat > 1.5 and (grounded and "walking" or "in the air") or "on the stone")
    end,
}

