            end
            for _, g in ipairs(d.g or {}) do
                if type(g) == "table" and g.i ~= nil then R.candy[g.i] = nil end
            end
        elseif ev == "score" then
            if d.id ~= nil then R.candy[d.id] = nil end
        end
    end,
    tick = function()
        local p = playerPos()
        if not p then return end
        local best, bestScore
        for i, c in pairs(R.candy or {}) do
            local score = dist(c.pos, p) - (c.k == 3 and 25 or 0)
            if not bestScore or score < bestScore then best, bestScore = i, score end
        end
        if not best then state.gamesNote = "Candy Rain: waiting for candy" return end
        local c = R.candy[best]
        if dist(c.pos, p) > (R.reach or 6) - 1 then
            teleportTo(Vector3.new(c.pos.X, math.max(c.pos.Y, p.Y - 3), c.pos.Z))
        end
        R.sent = R.sent or {}
        if os.clock() - (R.sent[best] or 0) > 1.25 then
            R.sent[best] = os.clock()
            nightInput("claim", { id = best })
        end
        state.gamesNote = "Candy Rain: collecting candy"
    end,
}

