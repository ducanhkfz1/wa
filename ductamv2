local function fireGameTrick(key)
    local success = false
    if isfn(G.HGNight, "Trick") then
        local ok = pcall(G.HGNight.Trick, key)
        if ok then success = true end
    end
    if not success and isfn(G.Network, "Fire") then
        local ok, result = gcall(G.Network.Fire, "Instancing_FireCustomFromClient", currentInstanceId(), "HG_Trick", key)
        if ok == true and result ~= false then success = true end
    end
    pcall(function()
        local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if pg then
            for _, btn in ipairs(pg:GetDescendants()) do
                if btn:IsA("GuiButton") and btn.Visible then
                    if string.find(string.lower(btn.Name), string.lower(key)) then
                        firesignal(btn.Activated)
                        success = true
                    end
                end
            end
        end
    end)
    if success then
        state.tricksUsed = (state.tricksUsed or 0) + 1
        print("⚡ [Xuantam Boost Success] Đã kích hoạt: " .. tostring(key))
    end
    return success
end

