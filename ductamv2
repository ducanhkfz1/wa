    end,
    tick = function()
        if R.phase ~= "scramble" or not R.group then return end
        local arena = arenaModel()
        local crypts = arena and arena:FindFirstChild("Crypts")
        if not crypts then return end
        local p = playerPos()
        if not p then return end
        local counts = R.counts or {}
        local open = {}
        for _, i in ipairs(R.crypts or {}) do open[tonumber(i)] = true end
        local function collide(i)
            local c = crypts:FindFirstChild("Crypt" .. i)
            return c and c:FindFirstChild("Collide") or nil
        end
        local function inside(i)
            local col = collide(i)
            if not col then return false end
            local lp = col.CFrame:PointToObjectSpace(p)
            return math.abs(lp.X) <= col.Size.X / 2 and math.abs(lp.Z) <= col.Size.Z / 2 and math.abs(lp.Y) <= col.Size.Y / 2 + 3
        end
        local function countOf(i) return tonumber(counts[i] or counts[tostring(i)]) or 0 end
        local left = serverLeft(R.endsAt)
        local function nearestOpen(except)
            local best, bestDist
            for i = 1, 8 do
                local col = collide(i)
                if i ~= except and open[i] and col and countOf(i) < R.group then
                    local d = dist(Vector3.new(p.X, col.Position.Y, p.Z), col.Position)
                    if not bestDist or d < bestDist then best, bestDist = i, d end
                end
            end
            return best
        end

        if not R.chosenCrypt then
            R.chosenCrypt = nearestOpen(nil)
            R.approachIndex = 1
            R.lastProgressPos = p
            R.lastProgressAt = os.clock()
            if not R.chosenCrypt then
                state.gamesNote = "Monster Mash: no available crypt to choose"
                return
            end
        end

        local mine = R.chosenCrypt
        local col = collide(mine)
        if not col then
            state.gamesNote = string.format("Monster Mash: waiting for crypt %d", mine)
            return
        end

        if not open[mine] and not inside(mine) then
            local nextCrypt = nearestOpen(mine)
            if nextCrypt then
                R.chosenCrypt = nextCrypt
                R.approachIndex = 1
                R.lastProgressPos = p
                R.lastProgressAt = os.clock()
                R.doorSent = nil
                mine = nextCrypt
                col = collide(mine)
            else
                state.gamesNote = "Monster Mash: selected crypt closed; waiting for another open crypt"
                stopMoving()
                return
            end
        end

        local currentCount = countOf(mine)
        local amInside = inside(mine)
        if amInside then
            stopMoving()
            if currentCount >= R.group and R.doorSent ~= mine then
                R.doorSent = mine
                nightInput("door", { crypt = mine })
                state.gamesNote = string.format("Monster Mash: crypt %d full (%d/%d), closing door", mine, currentCount, R.group)
            else
                state.gamesNote = string.format("Monster Mash: staying in crypt %d (%d/%d), waiting for players", mine, currentCount, R.group)
            end
            return
        end

        if not R.lastProgressPos or dist(p, R.lastProgressPos) > 1.25 then
            R.lastProgressPos = p
            R.lastProgressAt = os.clock()
        elseif os.clock() - (R.lastProgressAt or 0) > 1.8 then
            R.approachIndex = ((R.approachIndex or 1) % 4) + 1
            R.lastProgressPos = p
            R.lastProgressAt = os.clock()
            R.lastMove = 0
        end

        if os.clock() - (R.lastMove or 0) > (left < 5 and 0.35 or 0.8) then
            R.lastMove = os.clock()
            local offsets = {
                Vector3.new(0, 0, -col.Size.Z * 0.35),
                Vector3.new(col.Size.X * 0.35, 0, 0),
                Vector3.new(0, 0, col.Size.Z * 0.35),
                Vector3.new(-col.Size.X * 0.35, 0, 0),
            }
            local offset = offsets[R.approachIndex or 1]
            local localTarget = Vector3.new(offset.X, 0, offset.Z)
            local worldOffset = col.CFrame:VectorToWorldSpace(localTarget)
            local target = Vector3.new(col.Position.X + worldOffset.X, p.Y, col.Position.Z + worldOffset.Z)
            moveTo(target)
            state.gamesNote = string.format("Monster Mash: walking to nearest crypt %d (%d/%d), approach %d", mine, currentCount, R.group, R.approachIndex or 1)
        end
    end,
}

H.HotPumpkin = {
    onEvent = function(ev, d)
        R.holders = R.holders or {}
        if ev == "light" then
            R.holders[d.k] = d.holder
        elseif ev == "pass" then 
            R.holders[d.k] = d.to
        elseif ev == "pop" then 
            R.holders[d.k] = nil
        elseif ev == "over" then 
            R.over = true 
        end
    end,
    tick = function()
        if R.over then
            local h = humanoid()
            if h and R.savedWalkSpeed ~= nil then h.WalkSpeed = R.savedWalkSpeed end
            R.savedWalkSpeed = nil
            return
        end
        local st = nightState()
        local me = st and st.me
        local p = playerPos()
        if not (me and p) then return end
        
        local holding = false
        for _, hId in pairs(R.holders or {}) do 
            if hId == me then holding = true end 
        end
        
        if holding then
            local best, bestD
            local contestants = isfn(G.HGNight, "Contestants") and gval(G.HGNight.Contestants) or {}
            for id, c in pairs(contestants) do
                if id ~= me and type(c) == "table" and c.Alive ~= false and not c.Ghost then
                    local root = contestantRoot(id)
                    local d = root and dist(root.Position, p) or math.huge
                    if root and (not bestD or d < bestD) then best, bestD = id, d end
                end
            end
            if best then
                local root = contestantRoot(best)
                local h = humanoid()
                if h then
                    if R.savedWalkSpeed == nil then R.savedWalkSpeed = h.WalkSpeed end
                    h.WalkSpeed = math.max(R.savedWalkSpeed, 22)
                end
                if root and bestD > 3.5 then
                    moveTo(root.Position)
                end
                if bestD <= 6 and os.clock() - (R.lastPass or 0) > 0.25 then
                    R.lastPass = os.clock()
                    nightInput("pass", { id = best })
                end
                state.gamesNote = "Hot Pumpkin: đang bám đuổi với tốc độ cao để truyền bom"
            end
        else
            local h = humanoid()
            if h and R.savedWalkSpeed ~= nil then
                h.WalkSpeed = R.savedWalkSpeed
                R.savedWalkSpeed = nil
            end
            
            local away = Vector3.zero
            local danger = false
            local BOMB_DANGER_RANGE = 65
            
            for _, h_id in pairs(R.holders or {}) do
                local root = contestantRoot(h_id)
                if root then
                    local d = dist(root.Position, p)
                    if d < BOMB_DANGER_RANGE then
                        danger = true
                        local v = p - root.Position
                        away += (v.Magnitude > 0.1 and v.Unit or Vector3.new(1, 0, 0)) * math.max(1, BOMB_DANGER_RANGE - d)
                    end
                end
            end
            
            if not danger then
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character then
                        local root = plr.Character:FindFirstChild("HumanoidRootPart")
                        if root then
                            local d = dist(root.Position, p)
                            if d < 12 then
                                danger = true
                                local v = p - root.Position
                                away += (v.Magnitude > 0.1 and v.Unit or Vector3.new(1, 0, 0)) * (12 - d)
                            end
                        end
                    end
                end
            end
            
            if danger and os.clock() - (R.lastFlee or 0) > 0.3 then
                R.lastFlee = os.clock()
                setControls(false)
                
                local flatAway = Vector3.new(away.X, 0, away.Z)
                local fleeDir = flatAway.Magnitude > 0.1 and flatAway.Unit or Vector3.new(1, 0, 0)
                
                local arena = arenaModel()
                if arena then
                    local center = arena:GetPivot().Position
                    local toCenter = center - p
                    local flatToCenter = Vector3.new(toCenter.X, 0, toCenter.Z)
                    if flatToCenter.Magnitude > 35 then
                        flatToCenter = flatToCenter.Unit
                        local tangent1 = Vector3.new(-flatToCenter.Z, 0, flatToCenter.X)
                        local tangent2 = Vector3.new(flatToCenter.Z, 0, -flatToCenter.X)
                        if tangent1:Dot(fleeDir) > tangent2:Dot(fleeDir) then
                            fleeDir = (tangent1 * 1.5 + flatToCenter * 0.5).Unit
                        else
                            fleeDir = (tangent2 * 1.5 + flatToCenter * 0.5).Unit
                        end
                    end
                end
                
                local target = p + fleeDir * 14
                moveTo(target)
                state.gamesNote = "Hot Pumpkin: đang né tránh thông minh"
            elseif not danger and V.g.controlsOff then
                setControls(true)
                state.gamesNote = "Hot Pumpkin: an toàn"
            end
        end
    end,
}

H.TrickOrTreatDoors = {
    onEvent = function(ev, d)
        if ev == "wave" then
            R.doors = type(d.doors) == "table" and d.doors or {}
            R.bad = {}
            R.committed = false
            R.phase = "wave"
        elseif ev == "SniffHint" or ev == "lantern" then
            if d.doorId then R.bad[tonumber(d.doorId)] = true end
        elseif ev == "pick" then
            R.phase = "pick"
            R.pickAt = os.clock()
        elseif ev == "DoorRevealed" then
            if d.result == "trick" and d.doorId then R.bad = R.bad or {} R.bad[tonumber(d.doorId)] = true end
        elseif ev == "committed" then
            if d.id == (nightState() or {}).me then R.committed = true end
        elseif ev == "WaveResult" or ev == "missed" then
            R.phase = "done"
        end
    end,
    tick = function()
        if R.phase ~= "pick" or R.committed then return end
        local cands = {}
        for _, id in ipairs(R.doors or {}) do
            if not (R.bad and R.bad[tonumber(id)]) then cands[#cands + 1] = tonumber(id) end
        end
        if #cands == 0 then return end
        local st = nightState()
        local left = serverLeft(st and st.endsAt)
        local waited = os.clock() - (R.pickAt or os.clock())

        if #cands > 1 and left > 3 and waited < 7 then
            state.gamesNote = string.format("Trick or Treat Doors: %d doors possible, waiting for a hint", #cands)
            return
        end
        local choice = cands[math.random(1, #cands)]
        local arena = arenaModel()
        local booths = arena and arena:FindFirstChild("DoorBooths")
        local door = booths and booths:FindFirstChild("Door" .. choice)
        local trig = door and door:FindFirstChild("Trigger")
