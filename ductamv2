local function onRoundEvent(roundId, eventName, data, extra)
    if not (state.alive and Flags.AutoGames) then return end
    if roundId ~= V.g.round then
        resetRound(roundId)
        roundLog("== round %s | player=%s", tostring(roundId), tostring((nightState() or {}).me))
    end
    local handler = H[roundId]
    if handler and type(handler.onEvent) == "function" then
