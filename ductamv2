local function installRoundEventListener()
    local signal
    if isfn(G.Network, "Fired") then
        local ok, result = gcall(G.Network.Fired, "Instancing_FireCustomFromServer")
        if ok then signal = result end
    end
    if not (signal and type(signal.Connect) == "function") then
        local networkFolder = ReplicatedStorage:FindFirstChild("Network")
        local remote = networkFolder and networkFolder:FindFirstChild("Instancing_FireCustomFromServer")
        signal = remote and remote.OnClientEvent or nil
    end
    if not signal then
        warnlog("cannot listen to round events; auto minigames may not react to round signals")
        return
    end
    track(signal:Connect(function(instanceId, name, a, b, c, d)
        if name == "HG_Round" then
            onRoundEvent(a, b, c, d)
        elseif name == "HG_Night" and a == "saved" and type(b) == "table" then
            local st = nightState()
            if st and b.id == st.me and V.g.trickNight then
                local memory = V.g.trickNight[tostring(st.nightId)]
                if memory then memory.lastBoostSpam = 0 end
            end
        elseif name == "HG_Night" and a == "circle" and type(b) == "table" then
            V.g.circle = { phase = b.phase, nights = b.nights, night = b.night, at = os.clock() }
        end
    end))
    log("round event listener installed")
end
installRoundEventListener()

local function chosenNight(available)
    local requested = tonumber(tostring(F.gamesNight):match("%d+"))
    local nights = {}
    for _, value in ipairs(type(available) == "table" and available or {}) do
        local number = tonumber(value)
        if number then nights[#nights + 1] = number end
    end
    table.sort(nights)
    if requested then
        for _, number in ipairs(nights) do
            if number == requested then return number end
        end
    end
    return nights[#nights] or requested or 1
end

local function pickNight()
    local circle = V.g.circle
    if not (circle and circle.phase == "pick") then return false end
    if os.clock() - (V.g.lastPick or 0) < 4 then return false end
    V.g.lastPick = os.clock()
    local number = chosenNight(circle.nights)
    if isfn(G.HGNight, "Circle") then
        local ok = pcall(G.HGNight.Circle, "pick", number)
        if ok then
            state.gamesNote = "Selected Night " .. tostring(number)
            log("picked Night %d", number)
        end
    end
    return true
end

