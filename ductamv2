            state.gamesNote = string.format("Trick or Treat Doors: knocked on door %d (%d possible)", choice, #cands)
        end
    end,
}

H.PumpkinSmash = {
    onEvent = function(ev, d)
        R.avoid = R.avoid or {}
        if ev == "setup" then R.r = tonumber(d.r) or 6
        elseif ev == "omen" or ev == "flare" then
            local m = d.m or (type(d.pos) == "table" and d.pos.m)
            if m then R.avoid[m] = { pos = type(d.pos) == "table" and Vector3.new(d.pos.x or d.pos[1] or 0, d.pos.y or d.pos[2] or 0, d.pos.z or d.pos[3] or 0) or (d.x and Vector3.new(d.x, d.y, d.z)) } end
        elseif ev == "pop" then
            if d.m then R.avoid[d.m] = nil end
        end
    end,
    tick = function()
        checkAndPressBoost()
        local arena = arenaModel()
        local folder = arena and arena:FindFirstChild("Pumpkins")
        local p = playerPos()
        if not (folder and p) then return end
        for m, a in pairs(R.avoid or {}) do
            if a.pos and dist(a.pos, p) < (R.r or 6) + 3 then
                local v = p - a.pos
                v = Vector3.new(v.X, 0, v.Z)
                v = v.Magnitude > 0.1 and v.Unit or Vector3.new(1, 0, 0)
                teleportTo(p + v * ((R.r or 6) + 5))
                state.gamesNote = "Pumpkin Smash: dodging a Jack Bomb"
                return
            end
        end
        local best, bestD
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("Model") and (child:GetAttribute("Health") or 1) > 0 then
                local body = child:FindFirstChild("Body")
                local marker = child:GetAttribute("Marker")
                if body and body:IsA("BasePart") and not body:FindFirstChild("Ember") and not (R.avoid and marker and R.avoid[marker]) then
                    local d = dist(body.Position, p)
                    if not bestD or d < bestD then best, bestD = child, d end
                end
            end
        end
        if not best then state.gamesNote = "Pumpkin Smash: no pumpkin left" return end
        local body = best:FindFirstChild("Body")
        if bestD > 5 then
            local dir = body.Position - p
            dir = Vector3.new(dir.X, 0, dir.Z)
            dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.new(0, 0, 1)
            teleportTo(Vector3.new(body.Position.X, p.Y, body.Position.Z) - dir * 3)
        end
        if os.clock() - (R.lastPunch or 0) >= 0.26 then
            R.lastPunch = os.clock()
            nightInput("punch", { m = best:GetAttribute("Marker") })
            state.gamesNote = "Pumpkin Smash: smashing pumpkin " .. tostring(best:GetAttribute("Marker"))
        end
    end,
}

H.CoffinChairs = {
    onEvent = function(ev, d)
        R.active = R.active or {}
        R.taken = R.taken or {}
        if ev == "arrival" or ev == "promenade" then
            R.phase = ev
            R.seated = false
            R.claimTarget = nil
            R.claimTries = 0
            R.soon = nil
            R.opened = nil
            R.taken = {}
            if type(d.active) == "table" then
                R.active = {}
                for _, id in ipairs(d.active) do R.active[tonumber(id)] = true end
            end
        elseif ev == "flicker" then
            if type(d.coffins) == "table" then
                R.soon = {}
                for _, id in pairs(d.coffins) do if tonumber(id) then R.soon[tonumber(id)] = true end end
            end
            R.flicker = tonumber(d.coffin)
        elseif ev == "stop" then
            R.phase = "claim"
            if d.removed then R.active[tonumber(d.removed)] = nil end
            if type(d.opened) == "table" then
                R.opened = {}
                for _, id in pairs(d.opened) do if tonumber(id) then R.opened[tonumber(id)] = true end end
            end
            R.flicker = nil
            R.claimTarget = nil
            R.claimTries = 0
            R.lastClaim = 0
            if type(H.CoffinChairs.tick) == "function" then pcall(H.CoffinChairs.tick) end
        elseif ev == "lock" then
            R.taken[tonumber(d.coffin)] = d.id
            if d.id == (nightState() or {}).me then R.seated = true setControls(true) roundLog("coffin %s LOCKED for me", tostring(d.coffin)) end
        elseif ev == "still" then
            R.stills = (R.stills or 0) + 1
        elseif ev == "taken" then
            if R.claimTarget then R.taken[R.claimTarget] = true end
            R.claimTarget = nil
        elseif ev == "close" or ev == "resolve" then
            R.phase = "resolve"
        elseif ev == "champion" then
            R.phase = "done"
        end
    end,
    tick = function()
        local arena = arenaModel()
        local ring = arena and arena:FindFirstChild("CoffinRing")
        local p = playerPos()
        if not (ring and p) then return end
        local coffins = {}
        for _, c in ipairs(ring:GetChildren()) do
            local id = tonumber(string.match(c.Name, "^C(%d+)$"))
            if id and c:IsA("Model") then
                coffins[#coffins + 1] = { id = id, model = c, seat = c:FindFirstChild("Seat"), zone = c:FindFirstChild("ClaimZone") }
            end
        end
        local function spot(c)
            return partPos(c.seat) or partPos(c.zone) or partPos(c.model)
        end

        local function isOpen(c)
            local lid, shut = c.model:FindFirstChild("Lid"), c.model:FindFirstChild("LidShut")
            if not (lid and shut) then return true end
            local lp, sp = partPos(lid), partPos(shut)
            if not (lp and sp) then return true end
            return dist(lp, sp) > 0.6
        end
        local function usable(c)
            if R.active and next(R.active) ~= nil and not R.active[c.id] then return false end
            if R.taken and R.taken[c.id] then return false end
            if c.id == R.flicker then return false end
            if R.phase == "claim" then
                if R.opened and next(R.opened) ~= nil then return R.opened[c.id] == true end
                return isOpen(c)
            end
            if R.soon and next(R.soon) ~= nil then return R.soon[c.id] == true end
            return true
        end
        local function ringCenter()
            if R.center then return R.center, R.radius end
            local sum, n, far = Vector3.zero, 0, 0
            for _, c in ipairs(coffins) do
                local sp = spot(c)
                if sp then sum += sp n += 1 end
            end
            if n == 0 then return nil end
            local center = sum / n
            for _, c in ipairs(coffins) do
                local sp = spot(c)
                if sp then far = math.max(far, Vector3.new(sp.X - center.X, 0, sp.Z - center.Z).Magnitude) end
            end
            R.center, R.radius = center, math.max(far, 8)
            return center, R.radius
        end
        setControls(false)
        local rushing = R.phase ~= "claim" and R.soon ~= nil and next(R.soon) ~= nil
        if (R.phase == "claim" or rushing) and not R.seated then
            local best, bestD
            for _, c in ipairs(coffins) do
                if usable(c) then
                    local s = spot(c)
                    local d = s and dist(s, p) or math.huge
                    if s and (not bestD or d < bestD) then best, bestD = c, d end
                end
            end
            if not best then state.gamesNote = "Coffin Chairs: no open coffin left" return end
            local s = spot(best)
            if os.clock() - (R.lastClaim or 0) > 0.2 then
                R.lastClaim = os.clock()
                R.claimTries = (R.claimTarget == best.id) and (R.claimTries or 0) + 1 or 1
                R.claimTarget = best.id
                local h = humanoid()
                local seat = best.seat
                local c = LocalPlayer.Character
                local standing = R.claimTries % 2 == 0 and not rushing
                if standing then
                    if h then h.Sit = false end
                    teleportTo(s + Vector3.new(0, 2.5, 0))
                elseif seat and seat:IsA("Seat") and h then
                    teleportTo(seat.Position + Vector3.new(0, 2, 0))
                    pcall(seat.Sit, seat, h)
                else
                    local cf = (seat and seat:IsA("BasePart")) and seat.CFrame or CFrame.new(s)
                    if c then pcall(function() c:PivotTo(cf + Vector3.new(0, 1, 0)) end) end
                    if h then h.Sit = true end
                end
                task.wait(0.1)
                nightInput("claim", { coffin = best.id })
                local root = hrp()
                roundLog("coffin claim %d try %d (%s%s) me=%s seat=%s dist=%.1f", best.id, R.claimTries, standing and "standing" or "seated", rushing and ", early" or "", root and tostring(root.Position) or "?", tostring(s), root and dist(root.Position, s) or -1)
                state.gamesNote = string.format("Coffin Chairs: claiming coffin %d (try %d)", best.id, R.claimTries)
            end
        elseif R.phase == "promenade" or R.phase == "arrival" then
            local center, radius = ringCenter()
            if not center then return end
            local soon
            if R.soon and next(R.soon) ~= nil then
                local bestD
                for _, c in ipairs(coffins) do
                    if R.soon[c.id] and usable(c) then
                        local sp = spot(c)
                        local d = sp and dist(sp, p) or math.huge
                        if sp and (not bestD or d < bestD) then soon, bestD = c, d end
                    end
                end
            end
            R.angle = R.angle or math.atan2(p.Z - center.Z, p.X - center.X)
            local target
            if soon then
                local sp = spot(soon)
                local toC = Vector3.new(center.X - sp.X, 0, center.Z - sp.Z)
                toC = toC.Magnitude > 0.1 and toC.Unit or Vector3.new(0, 0, 1)
                local side = Vector3.new(-toC.Z, 0, toC.X)
                R.orbit = R.orbit or 0
                target = sp + toC * 4 + side * (3 * math.sin(R.orbit))
                if dist(Vector3.new(target.X, p.Y, target.Z), p) < 2 then R.orbit += 1.6 end
                state.gamesNote = "Coffin Chairs: circling coffin " .. soon.id
            else
                local r = radius * 0.6
                target = Vector3.new(center.X + math.cos(R.angle) * r, p.Y, center.Z + math.sin(R.angle) * r)
                if dist(Vector3.new(target.X, p.Y, target.Z), p) < 3 then R.angle += 0.5 end
                state.gamesNote = "Coffin Chairs: walking the ring"
            end
            moveTo(Vector3.new(target.X, p.Y, target.Z))
        end
    end,
}

H.GravestoneMemory = {
    onEvent = function(ev, d)
        if ev == "peek" and type(d.faces) == "table" then
            R.faces = {}
            for _, f in ipairs(d.faces) do
                if type(f) == "table" and type(f.s) == "number" and type(f.f) == "string" then R.faces[f.s] = f.f end
            end
            R.started = false
        elseif ev == "cleared" and d.id == (nightState() or {}).me then
            R.done = true
        end
    end,
    tick = function()
        if R.done or R.started or not R.faces then return end
        local st = nightState()
        local arena = arenaModel()
        local plots = arena and arena:FindFirstChild("Plots")
        if not (plots and st) then return end
        local plot
        for _, c in ipairs(plots:GetChildren()) do
            if c:GetAttribute("Owner") == st.me then plot = c break end
        end
        local stones = plot and plot:FindFirstChild("Stones")
        if not stones then return end
        local byIndex = {}
        for _, s in ipairs(stones:GetChildren()) do
            local i = tonumber(s:GetAttribute("Index"))
            if i then byIndex[i] = s end
        end
        local groups = {}
        for i, face in pairs(R.faces) do
            groups[face] = groups[face] or {}
            table.insert(groups[face], i)
        end
        R.started = true
        task.spawn(function()
            local pairsDone = 0
            for _, idx in pairs(groups) do
                if not state.alive or R.done or V.g.round ~= "GravestoneMemory" then return end
                if #idx >= 2 then
                    local a, b = idx[1], idx[2]
                    local sa, sb = byIndex[a], byIndex[b]
                    if sa and sb and not sa:GetAttribute("Matched") and not sb:GetAttribute("Matched") then
                        nightInput("Flip", { stone = a })
                        task.wait(0.45)
                        nightInput("Flip", { stone = b })
                        local t0 = os.clock()
                        repeat task.wait(0.1) until sb:GetAttribute("Matched") or os.clock() - t0 > 1.2
                        task.wait(0.25)
                        pairsDone += 1
                        state.gamesNote = string.format("Gravestone Memory: %d pairs flipped", pairsDone)
                    end
                end
            end
        end)
    end,
}

