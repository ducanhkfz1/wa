local function eventAvailable()
    if inEvent() then return true end
    if type(G.HG) ~= "table" or type(G.HGCmds) ~= "table" then return false end

    local things = workspace:FindFirstChild("__THINGS")
    local instances = things and things:FindFirstChild("Instances")
    if instances and instances:FindFirstChild(K.INSTANCE_ID) then return true end

    if isfn(G.Instancing, "GetRequirementTable") then
        local requirements = gval(G.Instancing.GetRequirementTable)
        if type(requirements) == "table" and requirements[K.INSTANCE_ID] ~= nil then return true end
        if type(requirements) == "table" and next(requirements) ~= nil then return false end
    end
    return true
end

