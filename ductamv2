local function hrp() return LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") end
local function humanoid() return LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") end
local function playerPos() local r = hrp() return r and r.Position or nil end
local function dist(a, b) return (a and b) and (a - b).Magnitude or math.huge end

local movementDriver = { target = nil, lastIssuedAt = 0, active = false }

local function resetMovementDriver()
    movementDriver.target = nil
    movementDriver.lastIssuedAt = 0
    movementDriver.active = false
end

local function setControls(enabled)
    pcall(function()
        local pm = require(LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
        local c = pm:GetControls()
        if enabled then c:Enable() else c:Disable() end
    end)
end

local function stopMoving()
    state.movingTo = nil
    resetMovementDriver()
    local h, r = humanoid(), hrp()
    if h then pcall(h.Move, h, Vector3.zero, false) end
    if r then
        pcall(function()
            local velocity = r.AssemblyLinearVelocity
            r.AssemblyLinearVelocity = Vector3.new(0, velocity.Y, 0)
        end)
    end
end

local function hardStopMoving()
    state.movingTo = nil
    resetMovementDriver()
    local h, r = humanoid(), hrp()
    if r then
        local pos = r.Position
        if h then
            pcall(function() h:MoveTo(pos) end)
            pcall(function() h:Move(Vector3.zero, false) end)
        end
        pcall(function()
            local velocity = r.AssemblyLinearVelocity
            r.AssemblyLinearVelocity = Vector3.new(0, velocity.Y, 0)
            r.AssemblyAngularVelocity = Vector3.zero
        end)
    elseif h then
        pcall(h.Move, h, Vector3.zero)
    end
end

local Recovery = {
    lastTeleportTarget = nil,
    sameTargetSince = nil,
    sameTargetLastAt = 0,
    sameTargetCount = 0,
    lastTeleportAt = 0,
    lastPosition = nil,
    stationarySince = os.clock(),
    lastRecoveryAt = 0,
    forceOut = false,
    forceOutNightId = nil,
    forceOutReason = nil,
    triggeredAt = 0,
    lastQueueTeleportAt = 0,
}

local function teleportTo(pos)
    if typeof(pos) == "Vector3" then
        local now = os.clock()
        local sameTarget = Recovery.lastTeleportTarget
            and dist(Recovery.lastTeleportTarget, pos) <= 1.25
        local recentRepeat = now - (Recovery.sameTargetLastAt or 0) <= 25

        if sameTarget and recentRepeat then
            Recovery.sameTargetCount += 1
        else
            Recovery.sameTargetSince = now
            Recovery.sameTargetCount = 1
        end

        Recovery.lastTeleportTarget = pos
        Recovery.sameTargetLastAt = now
        Recovery.lastTeleportAt = now
    end
    local c = LocalPlayer.Character
    if c then pcall(function() c:PivotTo(CFrame.new(pos)) end) end
end

-- ĐỔI SANG ĐI BỘ AN TOÀN ĐỂ TRÁNH BAN (SAFE WALK TO LOBBY / QUEUE)
local function safeWalkTo(pos)
    if typeof(pos) == "Vector3" then
        local h = humanoid()
        if h then
            pcall(function()
                h:MoveTo(pos)
            end)
            return
        end
    end
    teleportTo(pos)
end

local function edgeAhead(p, flatDir)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character }
    local origin = p + flatDir * 1.4 + Vector3.new(0, 1, 0)
    local hit = workspace:Raycast(origin, Vector3.new(0, -9, 0), params)
    return hit == nil
end

