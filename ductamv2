local function installStudioSpoof()
    if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function" then
        logOnce("no-studio-hook", "executor hook unavailable; using custom minigame handlers only")
        return
    end
    local oldNamecall
    local function namecallHandler(self, ...)
        if V.g.spoof and state.alive and self == RunService and getnamecallmethod() == "IsStudio" then
            return true
        end
        return oldNamecall(self, ...)
    end
    local ok, err = pcall(function()
        oldNamecall = hookmetamethod(game, "__namecall",
            type(newcclosure) == "function" and newcclosure(namecallHandler) or namecallHandler)
    end)
    if ok and type(oldNamecall) == "function" then
        V.g.spoofInstalled = true
        log("built-in autoplay hook installed")
    else
        warnlog("built-in autoplay hook failed: %s", tostring(err))
    end
end
local function setDevMarkers(enabled)
    if enabled and not V.g.spoofInstalled then return end
    pcall(function()
        if enabled then
            if V.g.savedDev == nil then
                V.g.savedDev = {
                    dev = workspace:GetAttribute("HalloweenGamesDev"),
                    pack = workspace:GetAttribute("__PS99Pack"),
                }
            end
            workspace:SetAttribute("HalloweenGamesDev", true)
            if workspace:GetAttribute("__PS99Pack") == nil then
                workspace:SetAttribute("__PS99Pack", "XuantamHub")
            end
            local gui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
            if gui and not gui:FindFirstChild("BotkitStatus") then
                local folder = Instance.new("Folder")
                folder.Name = "BotkitStatus"
                folder.Parent = gui
                V.g.botkit = folder
            end
        else
            if V.g.savedDev then
                workspace:SetAttribute("HalloweenGamesDev", V.g.savedDev.dev)
                workspace:SetAttribute("__PS99Pack", V.g.savedDev.pack)
                V.g.savedDev = nil
            end
            if V.g.botkit then
                V.g.botkit:Destroy()
                V.g.botkit = nil
            end
        end
    end)
    V.g.spoof = enabled == true and V.g.spoofInstalled == true
end
