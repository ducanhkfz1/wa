    V.g.trickNight = V.g.trickNight or {}
    local memory = V.g.trickNight[nightId]
    if not memory then
        memory = { lastBoostSpam = 0 }
        V.g.trickNight[nightId] = memory
    end

    if now - (memory.lastBoostSpam or 0) >= 6 then
        memory.lastBoostSpam = now
        fireGameTrick("LuckyCharm")
        fireGameTrick("Lucky Charm")
        fireGameTrick("TreatMagnet")
