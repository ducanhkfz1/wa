local function hasSpectatingNotice()
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not playerGui then return false end

    for _, object in ipairs(playerGui:GetDescendants()) do
        if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
            local visible = true
            local ancestor = object
            while ancestor and ancestor ~= playerGui do
                if ancestor:IsA("GuiObject") and not ancestor.Visible then
                    visible = false
                    break
                elseif ancestor:IsA("ScreenGui") and not ancestor.Enabled then
                    visible = false
                    break
                end
                ancestor = ancestor.Parent
            end

            if visible then
                local ok, value = pcall(function() return object.Text end)
                if ok and type(value) == "string" then
                    local message = string.lower(value)
                    local saysSpectating = string.find(message, "you are spectating", 1, true) ~= nil
                    local saysNextFromLobby = string.find(message, "you play the next one from the lobby", 1, true) ~= nil
                    if saysSpectating or saysNextFromLobby then return true end
                end
            end
        end
    end
    return false
end

local function triggerRecoveryLeave(st, reason)
    local now = os.clock()
    if Recovery.forceOut or now - (Recovery.lastRecoveryAt or 0) < 90 then return end

    Recovery.lastRecoveryAt = now
    Recovery.forceOutReason = tostring(reason)
    Recovery.triggeredAt = now
    Recovery.forceOutNightId = st and st.nightId or nil
    Recovery.forceOut = Recovery.forceOutNightId ~= nil

    if Recovery.forceOut then
        V.g.outSince = now - 3
        V.g.exitPressed = nil
        V.g.matchExitSent = nil
    else
        local pressed = false
        if isfn(G.HGMatch, "Press") then
            local ok, result = gcall(G.HGMatch.Press, "Exit")
            pressed = ok and result == true
        end
        if not pressed and isfn(G.HGNight, "Leave") then
            gcall(G.HGNight.Leave)
        end
        task.delay(12, function()
            if state.alive and isfn(G.HGNight, "MatchExit") then
                gcall(G.HGNight.MatchExit)
            end
        end)
    end

    stopMoving()
    setControls(true)
    state.gamesNote = "Recovery: leaving this Night as eliminated..."
    log("automatic leave recovery: %s", tostring(reason))
    notify("Auto Recovery", "Stuck/spectating state detected. Leaving this Night like a normal elimination...", 7)
end

task.spawn(function()
    while state.alive do
        task.wait(2)

        if not (Flags.AutoServerHop and Flags.AutoGames) then
            Recovery.lastPosition = playerPos()
            Recovery.stationarySince = os.clock()
            Recovery.lastTeleportTarget = nil
            Recovery.sameTargetSince = nil
            Recovery.sameTargetLastAt = 0
            Recovery.sameTargetCount = 0
            continue
        end

        if Recovery.forceOut then
            Recovery.lastPosition = playerPos()
            Recovery.stationarySince = os.clock()
            continue
        end

        local now = os.clock()
        local st = nightState()

        if hasSpectatingNotice() then
            if st and st.nightId ~= nil and st.phase ~= "ended" then
                triggerRecoveryLeave(st, "game UI reports that the player is spectating")
            elseif game.PlaceId == K.LOBBY_PLACE_ID then
                local position = playerPos()
                local queueDistance = position and Vector3.new(
                    position.X - K.LOBBY_QUEUE.X, 0, position.Z - K.LOBBY_QUEUE.Z
                ).Magnitude or math.huge
                if position and queueDistance > 4 and now - Recovery.lastQueueTeleportAt > 4 then
                    Recovery.lastQueueTeleportAt = now
                    teleportTo(K.LOBBY_QUEUE)
                end
                state.gamesNote = "Spectating: waiting on the lobby queue pad..."
            else
                triggerRecoveryLeave(st, "spectating banner detected without an active Night state")
            end
            continue
        end

        local me = nightMe()
        local alreadyEliminated = st and (
            st.out == true
            or (type(me) == "table" and me.Alive == false and st.match == true)
        )
        if alreadyEliminated then
            Recovery.lastPosition = playerPos()
            Recovery.stationarySince = now
            continue
        end

        local livePlay = st and st.nightId ~= nil and st.phase == "play"
        local redLightStop = V.g.round == "ScarecrowStare" and R.light ~= "green" and not R.done

        if not livePlay or redLightStop then
            Recovery.lastPosition = playerPos()
            Recovery.stationarySince = now
            if now - Recovery.lastTeleportAt > 25 then
                Recovery.lastTeleportTarget = nil
                Recovery.sameTargetSince = nil
                Recovery.sameTargetLastAt = 0
                Recovery.sameTargetCount = 0
            end
            continue
        end

        local position = playerPos()
        if position then
            if not Recovery.lastPosition or dist(position, Recovery.lastPosition) > 1.25 then
                Recovery.lastPosition = position
                Recovery.stationarySince = now
            end
        else
            Recovery.stationarySince = now
        end

        local repeatedFixedTeleport = Recovery.sameTargetSince
            and Recovery.sameTargetCount >= 3
            and now - Recovery.sameTargetSince >= 60
            and now - Recovery.sameTargetLastAt <= 25

        if repeatedFixedTeleport then
            triggerRecoveryLeave(st, "repeated teleports to the same fixed point for 60 seconds")
        elseif now - Recovery.stationarySince >= 60 then
            triggerRecoveryLeave(st, "no character movement for 60 seconds")
        end
    end
end)

local function gamesTick()
    if not Flags.AutoGames then
        if V.g.round ~= nil then resetRound(nil) end
        if V.g.spoof then setDevMarkers(false) end
        setControls(true)
        return
    end

    local st = nightState()
    if Recovery.forceOut and Recovery.forceOutNightId ~= nil then
        local sameNight = st and st.nightId ~= nil
            and tostring(st.nightId) == tostring(Recovery.forceOutNightId)
            and st.phase ~= "ended"
        if not sameNight then
            Recovery.forceOut = false
            Recovery.forceOutNightId = nil
            Recovery.forceOutReason = nil
            V.g.outSince, V.g.exitPressed, V.g.matchExitSent = nil, nil, nil
            Recovery.lastPosition = playerPos()
            Recovery.stationarySince = os.clock()
        end
    end
    if st and st.nightId ~= nil and st.phase ~= "ended" then
        if V.g.spoof == false then setDevMarkers(true) end
        if st.roundId ~= V.g.round then
            resetRound(st.roundId)
            if st.roundId then log("round started: %s", tostring(st.roundId)) end
        end

        if V.g.round and V.g.enabledFor ~= V.g.round and (st.phase == "play" or st.phase == "title") then
            local result = enableBuiltin(V.g.round)
            if result ~= nil then
                V.g.enabledFor = V.g.round
                V.g.builtinEnabled = result == true
                if result then log("built-in autoplay enabled for %s", tostring(V.g.round)) end
            else
                V.g.enabledFor = V.g.round
            end
        end

        local me = nightMe()
        local eliminated = Recovery.forceOut == true
            or st.out == true
            or (type(me) == "table" and me.Alive == false and st.match == true)
        if eliminated then
            if Recovery.forceOut and V.g.outSince == nil then
                V.g.outSince = Recovery.triggeredAt > 0 and (Recovery.triggeredAt - 3) or (os.clock() - 3)
            end
            V.g.outSince = V.g.outSince or os.clock()
            local elapsed = os.clock() - V.g.outSince
            if F.gamesLeaveWhenOut then
                -- ĐÃ CHỈNH: Đợi đúng 3 giây sau khi thua mới thực hiện bấm nút out ra ngoài
                if elapsed > 3 and not V.g.exitPressed then
                    V.g.exitPressed = true
                    local pressed = isfn(G.HGMatch, "Press") and gval(G.HGMatch.Press, "Exit")
                    if pressed ~= true and isfn(G.HGNight, "Leave") then pcall(G.HGNight.Leave) end
                end
                if elapsed > 15 and not V.g.matchExitSent then
                    V.g.matchExitSent = true
                    if isfn(G.HGNight, "MatchExit") then pcall(G.HGNight.MatchExit) end
                end
            end
            setControls(true)
            stopMoving()
            state.gamesNote = F.gamesLeaveWhenOut and "Eliminated, leaving the Night..." or "Eliminated, waiting for the Night to end..."
        else
            V.g.outSince, V.g.exitPressed, V.g.matchExitSent = nil, nil, nil
            if st.phase == "play" then
                trickPolicy(st)
                local handler = H[V.g.round]
                if handler and type(handler.tick) == "function" then
                    local ok, err = pcall(handler.tick)
                    if not ok then
                        logOnce("round-tick-" .. tostring(V.g.round) .. tostring(err):sub(1, 24),
                            "%s tick error: %s", tostring(V.g.round), tostring(err))
                    end
                elseif V.g.builtinEnabled then
                    state.gamesNote = "Running built-in autoplay: " .. tostring(V.g.round)
                else
                    state.gamesNote = "No autoplay available for: " .. tostring(V.g.round)
                end
            else
                state.gamesNote = string.format("Night %s: %s", tostring(st.number or "?"), tostring(st.phase))
                setControls(true)
            end
        end
        state.status = "Playing Halloween Games: " .. tostring(state.gamesNote)
        return
    end

    if V.g.spoof then setDevMarkers(false) end
    V.g.round = nil
    setControls(true)
    if pickNight() then return end
    state.gamesNote = "Waiting for the next match..."
    state.status = state.gamesNote
end

