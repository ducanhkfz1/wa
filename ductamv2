local function enterHalloweenEvent()
    if inEvent() then return true end
    if placeKind() ~= "world" then return true, "not in a world place" end
    if not eventAvailable() then return false, "Halloween Games event is not available in this game version" end
    if not isfn(G.Instancing, "Enter") then return false, "InstancingCmds.Enter is unavailable" end

    log("entering the Halloween Games event")
    local ok, result = gcall(G.Instancing.Enter, K.INSTANCE_ID)
    if not ok then return false, tostring(result) end

    local startedAt = os.clock()
    while state.alive and Flags.AutoJoin and os.clock() - startedAt < 25 do
        if inEvent() and instanceModel() then return true end
        task.wait(0.5)
    end
    if inEvent() then return true end
    return false, "timed out while waiting for the Halloween Games instance"
end

