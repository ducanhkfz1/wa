end)

local function giftsOwned()
    local total = 0
    local save = isfn(G.Save, "Get") and gval(G.Save.Get) or nil
    if save and type(save.Inventory) == "table" then
        for _, cat in pairs({"Lootbox", "Consumable", "Container"}) do
