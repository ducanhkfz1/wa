    local ok, result = gcall(G.HGNight.Input, kind, payload)
    return ok and result ~= false
end
local function roundsFolder()
    local library = ReplicatedStorage:FindFirstChild("Library")
    local client = library and library:FindFirstChild("Client")
    local cmds = client and client:FindFirstChild("HalloweenGamesCmds")
    return cmds and cmds:FindFirstChild("Rounds") or nil
end
local function roundModule(id)
    local st = nightState()
    if type(st) == "table" and st.roundId == id and type(st.roundClient) == "table" then
        return st.roundClient
    end
    V.g.mods = V.g.mods or {}
    if V.g.mods[id] ~= nil then return V.g.mods[id] or nil end
    local folder = roundsFolder()
    local node = folder and folder:FindFirstChild(id)
    if not node then V.g.mods[id] = false return nil end
    local ok, module = pcall(require, node)
    V.g.mods[id] = ok and type(module) == "table" and module or false
    return V.g.mods[id] or nil
end
local function moveTo(position)
    if position then state.movingTo = position end
end
local function serverLeft(endsAt)
    if type(endsAt) ~= "number" then return math.huge end
    return endsAt - serverNow()
end
local function partPos(inst)
    if not inst then return nil end
    local ok, position = pcall(function() return inst:GetPivot().Position end)
    return ok and position or nil
end
local function contestantRoot(id)
    if id == nil then return nil end
    if type(id) == "number" and id < 0 then
        local rig = isfn(G.HGNight, "Rig") and gval(G.HGNight.Rig, id) or nil
        return rig and rig.PrimaryPart or nil
    end
    local contestant = isfn(G.HGNight, "Contestant") and gval(G.HGNight.Contestant, id) or nil
    local player = contestant and contestant.UserId and Players:GetPlayerByUserId(contestant.UserId)
    return player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") or nil
end
local function atStoneEdge(position, flatDirection)
    local arena = arenaModel()
    local bridge = arena and arena:FindFirstChild("Bridge")
    if not bridge then return false end
    local closest, closestDistance
    for _, rowModel in ipairs(bridge:GetChildren()) do
        for lane = 1, 2 do
            local stone = rowModel:FindFirstChild("Stone" .. lane)
            local stonePosition = partPos(stone)
            if stonePosition then
                local distance = Vector3.new(position.X - stonePosition.X, 0, position.Z - stonePosition.Z).Magnitude
                if distance < 7.5 and (not closestDistance or distance < closestDistance) then
                    local size = stone:IsA("BasePart") and stone.Size or Vector3.new(10, 1, 10)
                    closest, closestDistance = { position = stonePosition, size = size }, distance
                end
            end
        end
    end
    if not closest then return false end
    local along = (position - closest.position):Dot(flatDirection)
    local half = math.min(closest.size.X, closest.size.Z) / 2
    return along >= half - 1.2
end

local function roundLog(fmt, ...)
    local ok, message = pcall(string.format, fmt, ...)
    log("[round] " .. (ok and message or tostring(fmt)))
end
local function compact(value, depth)
    depth = depth or 0
    if type(value) ~= "table" then return tostring(value) end
    if depth > 1 then return "{..}" end
    local parts, count = {}, 0
    for key, item in pairs(value) do
        count += 1
        if count > 12 then parts[#parts + 1] = "..." break end
        parts[#parts + 1] = tostring(key) .. "=" .. compact(item, depth + 1)
    end
    return "{" .. table.concat(parts, ",") .. "}"
end

