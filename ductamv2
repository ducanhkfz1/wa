            R.go = (light == "green" or light == "go")
            
            if not R.go then
                hardStopMoving()
                setControls(false)
                R.redLocked = true
            else
                R.redLocked = false
                resetMovementDriver()
            end
            
            if light == "over" then
                R.done = true
            end
        elseif ev == "finished" and d.id == (nightState() or {}).me then
            R.done = true
        end
