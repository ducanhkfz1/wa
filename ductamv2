H.BroomSweep = {
    tick = function()
        local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if not pg then return end
        local prompt = nil
        for _, obj in ipairs(pg:GetDescendants()) do
            if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                local txt = string.upper((obj.Text or ""):gsub("%s+", ""))
                if txt == "JUMP!" or txt == "DIVE!" then
                    if obj.Visible then prompt = txt break end
                end
            end
        end
        if not prompt then return end
        local now = os.clock()
        if prompt == R.lastPrompt and now - (R.lastPromptAt or 0) < 0.8 then return end
        if now - (R.lastActionAt or 0) < 0.35 then return end
        R.lastPrompt, R.lastPromptAt, R.lastActionAt = prompt, now, now
        
        if prompt == "JUMP!" then
            local h = humanoid()
            if h and h.FloorMaterial ~= Enum.Material.Air then h.Jump = true end
            state.gamesNote = "Night 1: JUMP prompt detected"
        elseif prompt == "DIVE!" then
            local sent = false
            for _, obj in ipairs(pg:GetDescendants()) do
                if obj:IsA("GuiButton") and obj.Visible then
                    local label = string.lower(obj:IsA("TextButton") and (obj.Text or "") or "")
                    if label == "" then
                        for _, child in ipairs(obj:GetDescendants()) do
                            if child:IsA("TextLabel") then
                                label = label .. " " .. string.lower(child.Text or "")
                            end
                        end
                    end
                    if string.find(label, "dive", 1, true) then
                        local ok = pcall(function() firesignal(obj.Activated) end)
                        if not ok then pcall(function() firesignal(obj.MouseButton1Click) end) end
                        if ok then sent = true break end
                    end
                end
            end
