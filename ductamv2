                for _, item in pairs(save.Inventory[cat]) do
                    if type(item) == "table" and (item.id == "Midnight Gift" or item.id == "Halloween Games Midnight Gift") then
                        total = total + (tonumber(item._am) or 1)
                    end
                end
            end
        end
    end
    return total
end

local function openGifts()
    local count = giftsOwned()
    if count > 0 then
        local openAmount = math.min(count, 8)
        if isfn(G.HGGift, "Open") then
            local ok = gcall(G.HGGift.Open, openAmount)
            if ok then
                state.giftsOpened = state.giftsOpened + openAmount
                return
            end
        end
    end
end

