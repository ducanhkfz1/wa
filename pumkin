    rowCorner.Parent = row

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, -100, 1, 0)
    textLabel.Position = UDim2.new(0, 12, 0, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = labelText
    textLabel.Font = Enum.Font.GothamSemibold
    textLabel.TextSize = 15
    textLabel.TextColor3 = Color3.fromRGB(245, 245, 245)
    textLabel.TextXAlignment = Enum.TextXAlignment.Left
    textLabel.Parent = row

    local toggleBg = Instance.new("Frame")
    toggleBg.Size = UDim2.new(0, 58, 0, 27)
    toggleBg.Position = UDim2.new(1, -70, 0.5, -13)
    toggleBg.BackgroundColor3 = Color3.fromRGB(100, 100, 110)
    toggleBg.BorderSizePixel = 0
    toggleBg.Parent = row

    local toggleCorner = Instance.new("UICorner")
    toggleCorner.CornerRadius = UDim.new(1, 14)
    toggleCorner.Parent = toggleBg

    local knob = Instance.new("TextButton")
    knob.Size = UDim2.new(0, 23, 0, 23)
    knob.Position = UDim2.new(0, 2, 0.5, -11.5)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.Text = ""
    knob.Parent = toggleBg

    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 12)
    knobCorner.Parent = knob

    local enabled = defaultValue == true

    local function updateState(value)
        enabled = value
        if enabled then
            toggleBg.BackgroundColor3 = Color3.fromRGB(73, 224, 116)
            knob.Position = UDim2.new(1, -25, 0.5, -11.5)
        else
            toggleBg.BackgroundColor3 = Color3.fromRGB(100, 100, 110)
            knob.Position = UDim2.new(0, 2, 0.5, -11.5)
        end

        if callback then
            callback(enabled)
        end
    end

    knob.MouseButton1Click:Connect(function()
        updateState(not enabled)
    end)

    updateState(enabled)
    return { set = updateState }
end

