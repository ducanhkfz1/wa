-- Feature structure
local function addFeature(labelText, defaultValue, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 48)
    row.BackgroundColor3 = Color3.fromRGB(29, 29, 36)
    row.BorderSizePixel = 0
    row.Parent = featureList

    addRounded(row, 12)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -120, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamSemibold
    label.Text = labelText
    label.TextColor3 = Color3.fromRGB(245, 245, 245)
    label.TextSize = 15
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    local toggleBg = Instance.new("Frame")
    toggleBg.Size = UDim2.new(0, 54, 0, 26)
    toggleBg.Position = UDim2.new(1, -66, 0.5, -13)
    toggleBg.BackgroundColor3 = Color3.fromRGB(85, 85, 92)
    toggleBg.BorderSizePixel = 0
    toggleBg.Parent = row
    addRounded(toggleBg, 13)

    local toggleButton = Instance.new("TextButton")
    toggleButton.Size = UDim2.new(0, 24, 0, 24)
    toggleButton.Position = UDim2.new(0, 2, 0.5, -12)
    toggleButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    toggleButton.BorderSizePixel = 0
    toggleButton.Text = ""
    toggleButton.Parent = toggleBg
    addRounded(toggleButton, 12)

    local enabled = defaultValue == true

    local function updateState(value)
        enabled = value
        if enabled then
            toggleBg.BackgroundColor3 = Color3.fromRGB(70, 220, 120)
            toggleButton.Position = UDim2.new(1, -26, 0.5, -12)
            toggleButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        else
            toggleBg.BackgroundColor3 = Color3.fromRGB(85, 85, 92)
            toggleButton.Position = UDim2.new(0, 2, 0.5, -12)
            toggleButton.BackgroundColor3 = Color3.fromRGB(230, 230, 230)
        end

        if callback then
            callback(enabled)
        end
    end

    toggleButton.MouseButton1Click:Connect(function()
        updateState(not enabled)
    end)

    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0, 8)
    padding.PaddingLeft = UDim.new(0, 0)
    padding.PaddingRight = UDim.new(0, 0)
    padding.PaddingBottom = UDim.new(0, 8)
    padding.Parent = featureList

    -- Keep row positions
    local children = featureList:GetChildren()
    table.sort(children, function(a, b)
        return a.AbsolutePosition.Y < b.AbsolutePosition.Y
    end)

    updateState(enabled)
    return {
        set = updateState
    }
end

