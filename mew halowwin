            local box = stone and boxOf(stone)
            if box and inBox(p, box, 0.5) and p.Y > box.pos.Y then return box end
        end
    end
    for _, name in ipairs({ "StartPlatform", "EndPlatform" }) do
        local plat = arena:FindFirstChild(name)
        local box = plat and boxOf(plat)
        if box and inBox(p, box, 0.5) and p.Y > box.pos.Y then return box end
    end
    return nil
end
local function jumpReach(h)
    local g = workspace.Gravity
    local vy = h.UseJumpPower and h.JumpPower or math.sqrt(2 * g * h.JumpHeight)
    return h.WalkSpeed * 2 * vy / g
end
local function ensureHopWatcher()
    if R.hopConn then return end
    local mine = R
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if R ~= mine or not state.alive then
            conn:Disconnect()
            return
        end
        local hop = R.hop
        if not hop or R.done or not hop.wp then return end
        local h, r = humanoid(), hrp()
        if not (h and r) or h.FloorMaterial == Enum.Material.Air then return end
        if os.clock() - (R.lastJump or 0) < 0.6 then return end
        local dx, dz = r.Position.X - hop.wp.X, r.Position.Z - hop.wp.Z
        if dx * dx + dz * dz <= 0.36 then
            R.lastJump = os.clock()
            R.stepSince = os.clock()
            moveTo(hop.target)
            h.Jump = true
            roundLog("bridge jump to %s (edge, walk %s, reach %.1f, gap %.1f)", hop.label, tostring(h.WalkSpeed), jumpReach(h), (Vector3.new(r.Position.X, 0, r.Position.Z) - Vector3.new(hop.nearest.X, 0, hop.nearest.Z)).Magnitude)
        end
    end)
    track(conn)
    R.hopConn = conn
end
local function hopToward(h, p, arena, box, aim, label)
    ensureHopWatcher()
    local flatAim = Vector3.new(aim.X, p.Y, aim.Z)
    if not h or h.FloorMaterial == Enum.Material.Air then
        R.hop = nil
        moveTo(flatAim)
        return
    end
    local support = bridgeSupport(arena, p)
    if not support or support.pos == box.pos then
        R.hop = nil
        moveTo(flatAim)
        return support ~= nil
    end
    local wp = clampToBox(flatAim, support, 0.3)
    R.hop = { wp = wp, target = flatAim, nearest = clampToBox(wp, box, 0), label = label }
    moveTo(wp)
    return true
end
