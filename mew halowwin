                local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
                if root and not (hum and hum.Health <= 0) then roots[#roots + 1] = { key = "p" .. plr.UserId, pos = root.Position } end
            end
        end
        for id in pairs(type(contestants) == "table" and contestants or {}) do
            if type(id) == "number" and id < 0 and not R.dead[id] then
                local root = contestantRoot(id)
                if root then roots[#roots + 1] = { key = "b" .. id, pos = root.Position } end
            end
        end
        local endP = arena:FindFirstChild("EndPlatform")
        local endPos = partPos(endP)
        local endSize = (endP and endP:IsA("BasePart")) and endP.Size or Vector3.new(27, 1, 29)
        local function stoneAt(rp)
            for r = math.max(1, nextRow - 1), nextRow + 5 do
                local rowModel = bridge:FindFirstChild("Row" .. r)
                if not rowModel then
                    if endPos and math.abs(rp.X - endPos.X) <= endSize.X / 2 and math.abs(rp.Z - endPos.Z) <= endSize.Z / 2 then
                        return r, 0, endPos
                    end
                    break
                end
                for l = 1, 2 do
                    local sp = rowModel and partPos(rowModel:FindFirstChild("Stone" .. l))
                    if sp and math.abs(rp.X - sp.X) <= 4.5 and math.abs(rp.Z - sp.Z) <= 4.5 then
                        return r, l, sp
                    end
                end
            end
            return nil
        end
        local function markSafe(r, l, why)
            if not R.known[r] then
                R.known[r] = l
                log("Tombstone Bridge: row %d lane %d is safe (%s)", r, l, why)
                roundLog("bridge: row %d lane %d safe (%s)", r, l, why)
            end
        end
        local function markBad(r, l, why)
            local other = l == 1 and 2 or 1
            if R.known[r] ~= other then
                R.known[r] = other
                log("Tombstone Bridge: row %d lane %d is bad (%s), taking lane %d", r, l, why, other)
                roundLog("bridge: row %d lane %d bad (%s)", r, l, why)
            end
        end
        for _, e in ipairs(roots) do
            local r, l, sp = stoneAt(e.pos)
            if r then
                local dy = e.pos.Y - sp.Y
                if dy < -2 then
                    markBad(r, l, "someone fell through it")
                elseif dy > 1.5 and dy < 5.5 then
                    local last = R.lastOn[e.key]
                    if last and last.row == r - 1 and r - 1 >= 1 and last.lane > 0 and now - last.since >= 0.25 and last.samples >= 2 then
                        markSafe(last.row, last.lane, string.format("%s stood %.1fs on it then %s", e.key, now - last.since, l == 0 and "reached the end" or "crossed"))
                    end
                    if not last or last.row ~= r or last.lane ~= l then
                        R.lastOn[e.key] = { row = r, lane = l, since = now, samples = 1 }
                    else
                        last.samples += 1
                    end
                    if l > 0 then
                        local key = r .. ":" .. l
                        R.seen[key] = R.seen[key] or now
                        if now - R.seen[key] >= 1.5 then markSafe(r, l, e.key .. " stood on it for 1.5 s") end
                    end
                end
            end
        end
        for key, t in pairs(R.seen) do
            local alive = false
            for _, e in ipairs(roots) do
                local r, l = stoneAt(e.pos)
                if r and (r .. ":" .. l) == key and e.pos.Y > 0 then alive = true break end
            end
            if not alive then R.seen[key] = nil end
        end
        local lane = R.known[nextRow]
        local waited = os.clock() - (R.rowSince or os.clock())
        if not lane then

            if waited > 1.5 and not R.lanternAsked then
                R.lanternAsked = os.clock()
            end
            local mustMove = R.mustMoveBy and serverNow() >= R.mustMoveBy - 0.5
            local left = R.endsAt and (R.endsAt - serverNow()) or math.huge
            local rowsLeft = math.max(1, (R.rows or 12) - (R.progress or 0) + 1)
            local standingLane, standingFor
            for l = 1, 2 do
                local t = R.seen[nextRow .. ":" .. l]
                if t and (not standingFor or now - t > standingFor) then standingLane, standingFor = l, now - t end
            end
            local hurry = left < rowsLeft * 1.2 + 1
            local behind = waited > left / rowsLeft and left < 30
            if mustMove or hurry then
                lane = (standingLane and standingFor >= 0.4) and standingLane or math.random(1, 2)
                R.known[nextRow] = lane
                local why = mustMove and "our row is falling" or string.format("%.0fs left for %d rows", left, rowsLeft)
                log("Tombstone Bridge: row %d still unknown, %s, taking lane %d", nextRow, why, lane)
                roundLog("bridge: row %d lane %d gamble (%s%s)", nextRow, lane, why, standingLane == lane and ", someone stands there" or "")
            elseif behind and standingLane and standingFor >= 0.8 then
                lane = standingLane
                R.known[nextRow] = lane
                roundLog("bridge: row %d lane %d taken early (%.0fs left, %s stood %.1fs)", nextRow, lane, left, "someone", standingFor)
            else
                state.gamesNote = string.format("Tombstone Bridge: row %d, waiting to see the safe stone (%ds)", nextRow, math.floor(waited))
                R.hop = nil
                return
            end
        end
        R.lanternAsked = nil

        local stone = row:FindFirstChild("Stone" .. lane)
        local pos = partPos(stone)
        if not pos then return end
        setControls(false)
        local h = humanoid()
        local target = Vector3.new(pos.X, p.Y, pos.Z)
        local flat = Vector3.new(p.X - pos.X, 0, p.Z - pos.Z).Magnitude
        if R.stepKey ~= nextRow .. ":" .. lane then
            R.stepKey = nextRow .. ":" .. lane
            R.stepSince = os.clock()
            R.jumped = false
        end
        local known = hopToward(h, p, arena, boxOf(stone), target, string.format("row %d lane %d", nextRow, lane))

        local flatDir = Vector3.new(pos.X - p.X, 0, pos.Z - p.Z)
        flatDir = flatDir.Magnitude > 0.1 and flatDir.Unit or Vector3.new(0, 0, -1)
        local grounded = h and h.FloorMaterial ~= Enum.Material.Air
        local stale = os.clock() - (R.stepSince or os.clock()) > 2.5 and os.clock() - (R.lastJump or 0) > 2
        if h and grounded and flat > 1.5 and os.clock() - (R.lastJump or 0) > 0.7 and ((known == false and edgeAhead(p, flatDir)) or stale) then
            R.lastJump = os.clock()
            R.stepSince = os.clock()
            h.Jump = true
            roundLog("bridge jump to row %d lane %d (%s)", nextRow, lane, stale and "stale" or "edge")
        end
        state.gamesNote = string.format("Tombstone Bridge: row %d lane %d, %s", nextRow, lane, flat > 1.5 and (grounded and "walking" or "in the air") or "on the stone")
    end,
}

H.MonsterMash = {
    onEvent = function(ev, d)
        if ev == "reveal" or ev == "scramble" then
            R.group = tonumber(d.groupSize) or R.group
            R.crypts = type(d.crypts) == "table" and d.crypts or R.crypts
            R.endsAt = tonumber(d.endsAt) or R.endsAt
            R.phase = ev
            R.doorSent = nil
        elseif ev == "counts" then
            R.group = tonumber(d.groupSize) or R.group
            R.counts = type(d.n) == "table" and d.n or R.counts
        elseif ev == "seal" or ev == "resolve" or ev == "reset" then
            R.phase = ev
        end
    end,
    tick = function()
        if R.phase ~= "scramble" or not R.group then return end
        local arena = arenaModel()
        local crypts = arena and arena:FindFirstChild("Crypts")
        if not crypts then return end
        local p = playerPos()
        if not p then return end
        local counts = R.counts or {}
        local open = {}
        for _, i in ipairs(R.crypts or {}) do open[tonumber(i)] = true end
        local function collide(i)
            local c = crypts:FindFirstChild("Crypt" .. i)
            return c and c:FindFirstChild("Collide") or nil
        end
        local function inside(i)
            local col = collide(i)
            if not col then return false end
            local lp = col.CFrame:PointToObjectSpace(p)
            return math.abs(lp.X) <= col.Size.X / 2 and math.abs(lp.Z) <= col.Size.Z / 2 and math.abs(lp.Y) <= col.Size.Y / 2 + 3
        end
        local mine
        for i = 1, 8 do if inside(i) then mine = i break end end
        local function countOf(i) return tonumber(counts[i] or counts[tostring(i)]) or 0 end
        local left = serverLeft(R.endsAt)

        if mine and countOf(mine) == R.group then
            if R.doorSent ~= mine then
                R.doorSent = mine
                nightInput("door", { crypt = mine })
            end
            state.gamesNote = string.format("Monster Mash: crypt %d is full (%d), door closed", mine, R.group)
            return
        end
        local best, bestScore, bestD
        for i = 1, 8 do
            if open[i] then
                local c = countOf(i) - ((i == mine) and 1 or 0)
                if c < R.group then
                    local score = c
                    if c == R.group - 1 then score = score + 100 end
                    local col = collide(i)
                    local d = col and dist(col.Position, p) or math.huge
                    if not bestScore or score > bestScore or (score == bestScore and d < bestD) then best, bestScore, bestD = i, score, d end
                end
            end
        end
        if not best then
            state.gamesNote = "Monster Mash: every open crypt is full"
            return
        end
        if best == mine then
            state.gamesNote = string.format("Monster Mash: crypt %d has %d of %d, waiting for more", mine, countOf(mine), R.group)
            return
        end

        if os.clock() - (R.lastMove or 0) > (left < 5 and 0.4 or 1.2) then
            R.lastMove = os.clock()
            local col = collide(best)
            if col then
                teleportTo(col.Position)
                state.gamesNote = string.format("Monster Mash: going to crypt %d (%d of %d)", best, countOf(best), R.group)
            end
        end
    end,
}

