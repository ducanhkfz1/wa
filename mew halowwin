UI.tips = {}
local function attachTip(row, text)
    local mark = Instance.new("TextLabel")
    mark.Name = "VyHelp"
    mark.BackgroundTransparency = 1
    mark.AnchorPoint = Vector2.new(1, 0)
    mark.Position = UDim2.new(1, -2, 0, 2)
    mark.Size = UDim2.new(0, 14, 0, 14)
    mark.Font = Enum.Font.GothamBold
    mark.TextSize = 11
    mark.Text = "?"
    mark.TextColor3 = Color3.fromRGB(255, 140, 0)
    mark.TextTransparency = 0.25
    mark.ZIndex = (row.ZIndex or 1) + 5
    mark.Parent = row
    local mouse = LocalPlayer:GetMouse()
    local function place()
        if UI.tipGui then UI.tipGui.Position = UDim2.new(0, mouse.X + 14, 0, mouse.Y - 6) end
    end
    track(row.MouseEnter:Connect(function()
        local f = tipLayer()
        f.Text.Text = text
        f.Visible = true
        place()
    end))
    track(row.MouseMoved:Connect(function() if UI.tipGui and UI.tipGui.Visible then place() end end))
    track(row.MouseLeave:Connect(function() if UI.tipGui then UI.tipGui.Visible = false end end))
end
local function tip(sec, name, text)
    UI.tips[#UI.tips + 1] = { name = name, text = text }
end
local function attachPendingTips()
    local pending = {}
    for _, t in ipairs(UI.tips) do if not t.done then pending[#pending + 1] = t end end
    if #pending == 0 then return end
    local roots = {}
    for _, h in ipairs({ Library.Holder, Library.UnusedHolder }) do
        if type(h) == "table" and h.Instance then roots[#roots + 1] = h.Instance end
    end
    local all = {}
    for _, r in ipairs(roots) do for _, d in ipairs(r:GetDescendants()) do all[#all + 1] = d end end
    for _, d in ipairs(all) do
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Name ~= "VyHelp" then
            for _, t in ipairs(pending) do
                if not t.done and type(d.Text) == "string" and d.Text == t.name then
                    local row = d:IsA("TextButton") and d or d.Parent
                    if row and row:IsA("GuiObject") and not row:FindFirstChild("VyHelp") then
                        t.done = true
                        pcall(attachTip, row, t.text)
                    end
                end
            end
        end
    end
end

