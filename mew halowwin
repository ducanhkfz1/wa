local function webhookTick()
    if not F.webhookEnabled then V.webhookSeen = nil return end
    local pets = webhookPets()
    if not pets then state.webhookNote = "inventory not readable yet" return end
    if type(V.webhookSeen) ~= "table" then
        local seen, count = {}, 0
        for uid, data in pairs(pets) do
            seen[uid] = type(data) == "table" and (tonumber(data._am) or 1) or 1
            count += 1
        end
        V.webhookSeen = seen
        state.webhookNote = string.format("watching %d pet stacks for: %s", count, table.concat(F.webhookKeywords, ", "))
        return
    end
    for uid, data in pairs(pets) do
        if type(data) == "table" then
            local amount = tonumber(data._am) or 1
            local prev = V.webhookSeen[uid]
            if prev == nil or amount > prev then
                local name = petDisplayName(data)
                log("new pet: %s (x%d)", name, amount)
                if webhookMatches(name) then task.spawn(sendPetWebhook, name, amount, data) end
            end
            V.webhookSeen[uid] = amount
        end
    end
    for uid in pairs(V.webhookSeen) do
        if pets[uid] == nil then V.webhookSeen[uid] = nil end
    end
end

