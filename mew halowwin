    for word in string.gmatch(tostring(text or ""), "[^,]+") do
        local w = string.lower(word):gsub("^%s+", ""):gsub("%s+$", "")
        if w ~= "" then list[#list + 1] = w end
    end
    F.webhookKeywords = list
end
