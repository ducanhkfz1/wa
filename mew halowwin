        end

        R.seen = R.seen or {}
        R.lastOn = R.lastOn or {}
        local now = os.clock()
        local roots = {}
        local contestants = isfn(G.HGNight, "Contestants") and gval(G.HGNight.Contestants) or nil
        local deadUsers = {}
