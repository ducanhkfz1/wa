H.BroomSweep = {
    onEvent = function(ev, d)
        if ev == "sweep" then
            R.cfg = d
            if typeof(d.origin) == "CFrame" then R.origin = d.origin end
        elseif ev == "phase" then R.phase = d.phase
        elseif ev == "swept" and d.id == (nightState() or {}).me then
            R.out = true
            roundLog("BroomSweep: swept out by the %s broom", tostring(d.arm))
        elseif ev == "resolve" then R.over = true end
    end,
    tick = function()
        if R.out or R.over or R.watch or not (R.cfg and R.origin) then return end
        local cfg = R.cfg
        local function swept(events, t)
            local last, mult, acc = 0, 1, 0
            for _, e in ipairs(events) do
                if t <= e.at then break end
                acc = acc + mult * (e.at - last)
                local m = math.min(e.ramp, t - e.at)
                acc = acc + (mult + (mult + (e.mult - mult) * m / e.ramp)) / 2 * m
                if m < e.ramp then return acc end
                last = e.at + e.ramp
                mult = e.mult
            end
            return acc + mult * (t - last)
        end
        local function angle(t)
            if t <= cfg.intro then return 0 end
            local w = 2 * math.pi / cfg.period
            local u = t - cfg.intro
            if u <= cfg.countdown then return w * u * u / (2 * cfg.countdown) end
            return w * cfg.countdown / 2 + w * swept(cfg.events or {}, u - cfg.countdown)
        end
        local function nextCross(arm, phi, r, now)
            local reach = arm == "high" and cfg.highReach or cfg.lowReach
            if r < (cfg.poleRadius or 0) or r > math.min(reach or cfg.rimRadius, cfg.rimRadius) then return nil end
            local off = arm == "high" and math.pi / 2 or 0
            local prev = (phi - (angle(now) + off)) % math.pi
            local t = now
            while t < now + 2 do
                t = t + 0.01
                local cur = (phi - (angle(t) + off)) % math.pi
                if prev < cur then return t end
                prev = cur
            end
            return nil
        end
        local mine = R
        local lastDuck, doneLow, doneHigh = 0, -1, -1
        local conn
        conn = RunService.Heartbeat:Connect(function()
            if R ~= mine or mine.out or mine.over or not state.alive then conn:Disconnect() return end
            local h, root = humanoid(), hrp()
            if not (h and root) then return end
            local now = serverNow() - (cfg.t0 or 0)
            if now < cfg.intro + cfg.countdown - 0.5 then return end
            local lp = mine.origin:PointToObjectSpace(root.Position)
            local phi = math.atan2(lp.Z, lp.X)
            local r = math.sqrt(lp.X * lp.X + lp.Z * lp.Z)
            local low = nextCross("low", phi, r, now)
            local high = nextCross("high", phi, r, now)
            if low and low - now <= 0.34 and math.abs(low - doneLow) > 0.3 then
                doneLow = low
                if h.FloorMaterial ~= Enum.Material.Air then
                    h.Jump = true
                    pcall(function() h:ChangeState(Enum.HumanoidStateType.Jumping) end)
                end
            end
            if high and high - now <= 0.17 and math.abs(high - doneHigh) > 0.3 and os.clock() - lastDuck >= (cfg.cooldown or 1) then
                doneHigh = high
                lastDuck = os.clock()
                nightInput("duck", { t = serverNow() })
            end
            state.gamesNote = string.format("Broom Sweep: low in %.1fs, high in %.1fs", low and (low - now) or -1, high and (high - now) or -1)
        end)
        track(conn)
        R.watch = conn
        roundLog("BroomSweep: timing jumps and dives from the broom angle (period %.2f)", cfg.period or -1)
    end,
}

H.HotPumpkin = {
    onEvent = function(ev, d)
        R.pumps = R.pumps or {}
        if ev == "light" then
            R.pumps[d.k] = { holder = d.holder, popAt = tonumber(d.popAt) }
        elseif ev == "pass" then
            R.pumps[d.k] = R.pumps[d.k] or {}
            R.pumps[d.k].holder = d.to
        elseif ev == "pop" then R.pumps[d.k] = nil
        elseif ev == "lantern" and type(d.pumpkins) == "table" then
            for _, x in ipairs(d.pumpkins) do if R.pumps[x.k] then R.pumps[x.k].popAt = tonumber(x.popAt) end end
        elseif ev == "over" then R.over = true end
    end,
    tick = function()
        if R.over then return end
        local h, root = humanoid(), hrp()
        local arena = arenaModel()
        if not (h and root and arena) then return end
        if not R.boostConn then
            local mine = R
            local conn
            conn = RunService.Heartbeat:Connect(function(dt)
                if R ~= mine or not state.alive or mine.over then conn:Disconnect() return end
                local hum, r = humanoid(), hrp()
                if not (hum and r) or (F.pumpkinBoost or 0) <= 0 then return end
                local md = hum.MoveDirection
                if md.Magnitude > 0.1 and hum.FloorMaterial ~= Enum.Material.Air then
                    r.CFrame = r.CFrame + Vector3.new(md.X, 0, md.Z).Unit * hum.WalkSpeed * (F.pumpkinBoost / 100) * dt
                end
            end)
            track(conn)
            R.boostConn = conn
        end
        local others, me = aliveOthers()
        local p = root.Position
        local holders, mine = {}, nil
        for _, pk in pairs(R.pumps or {}) do
            if pk.holder == me then mine = pk elseif pk.holder ~= nil then holders[#holders + 1] = pk.holder end
        end
        setControls(false)
        if mine then
            local best, bestD
            for _, o in ipairs(others) do
                local d = flatDist(o.root.Position, p)
                if not bestD or d < bestD then best, bestD = o, d end
            end
            if not best then return end
            local left = mine.popAt and (mine.popAt - serverNow()) or math.huge
            if bestD > 4 and (left < 2.5 or bestD > 40) then
                local dir = flat(best.root.Position - p)
                dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.new(0, 0, 1)
                teleportTo(best.root.Position - dir * 2.5)
                roundLog("HotPumpkin: %.1fs left, jumped next to contestant %s", left, tostring(best.id))
            else
                moveTo(best.root.Position)
            end
            if bestD <= 4.5 and os.clock() - (R.lastPass or 0) > 0.3 then
                R.lastPass = os.clock()
                nightInput("pass", { id = best.id })
            end
            state.gamesNote = string.format("Hot Pumpkin: passing it (%.1fs left, %d studs)", left, math.floor(bestD))
            return
        end
        if #holders == 0 then
            stopMoving()
            state.gamesNote = "Hot Pumpkin: waiting"
            return
        end
        local danger = {}
        for _, id in ipairs(holders) do
            local r = contestantRoot(id)
            if r then danger[#danger + 1] = r.Position end
        end
        if not R.spots then
            R.spots = {}
            local cf, size = arena:GetBoundingBox()
            for i = -4, 4 do
                for j = -4, 4 do
                    local pt = cf:PointToWorldSpace(Vector3.new(i / 4 * size.X * 0.42, 0, j / 4 * size.Z * 0.42))
                    local g = groundAt(pt.X, pt.Z, arena, p.Y)
                    if g and math.abs(g.Y - p.Y) < 8 then R.spots[#R.spots + 1] = g end
                end
            end
        end
        local function score(pt)
            local m = math.huge
            for _, dp in ipairs(danger) do m = math.min(m, flatDist(pt, dp)) end
            return m
        end
        local here = score(p)
        if not R.goal or os.clock() - (R.goalAt or 0) > 0.6 then
            local best, bestS = nil, -1
            for _, pt in ipairs(R.spots) do
                local sc = score(pt) - flatDist(pt, p) * 0.15
                if sc > bestS then best, bestS = pt, sc end
            end
            R.goal, R.goalAt = best, os.clock()
        end
        if here < 7 and os.clock() - (R.lastEscape or 0) > 1.5 and R.goal then
            R.lastEscape = os.clock()
            teleportTo(R.goal + Vector3.new(0, 3, 0))
            roundLog("HotPumpkin: holder %.1f studs away, moved away", here)
        elseif R.goal then
            moveTo(Vector3.new(R.goal.X, p.Y, R.goal.Z))
        end
        state.gamesNote = string.format("Hot Pumpkin: keeping away (%d studs from the pumpkin)", math.floor(here))
    end,
}

H.LightsOut = {
    onEvent = function(ev, d)
        if ev == "state" then
            R.cx, R.cz = tonumber(d.cx), tonumber(d.cz)
            R.r = tonumber(d.r) or R.r
            if d.ph == "hunt" then R.hunt = true end
        elseif ev == "intro" then
            if type(d.center) == "table" then R.cx, R.cz = tonumber(d.center.x), tonumber(d.center.z) end
            R.r = tonumber(d.radius) or R.r
        elseif ev == "pulse" then
            R.dark = d.on == true
            if R.dark then stopMoving() end
        elseif ev == "attack" then
            R.attack = { k = d.k, fx = tonumber(d.fx), fz = tonumber(d.fz), tx = tonumber(d.tx), tz = tonumber(d.tz), r = tonumber(d.r) or 7, w = tonumber(d.w) or 7, at = tonumber(d.at) or (serverNow() + 1.5) }
        elseif ev == "strike" then
            R.attack = nil
        elseif ev == "caught" and d.id == (nightState() or {}).me then
            R.out = true
            roundLog("LightsOut: caught")
        elseif ev == "flare" then R.over = true end
    end,
    tick = function()
        if R.out or R.over then return end
        local root = hrp()
        if not (root and R.cx) then return end
        local p = root.Position
        setControls(false)
        local a = R.attack
        if a and serverNow() > a.at + 0.6 then a, R.attack = nil, nil end
        local function inAttack(x, z, margin)
            if not a then return false end
            if a.k == "pounce" then
                return Vector2.new(x - a.tx, z - a.tz).Magnitude <= a.r + margin
            end
            local ax, az = a.tx - a.fx, a.tz - a.fz
            local len = math.sqrt(ax * ax + az * az)
            if len < 0.1 then return Vector2.new(x - a.tx, z - a.tz).Magnitude <= a.w / 2 + margin end
            local ux, uz = ax / len, az / len
            local along = (x - a.fx) * ux + (z - a.fz) * uz
            local side = math.abs(-(x - a.fx) * uz + (z - a.fz) * ux)
            return along >= -margin and along <= len + margin and side <= a.w / 2 + margin
        end
        if inAttack(p.X, p.Z, 2) then
            local best, bestD
            local lightR = math.max((R.r or 0) - 1.5, 0)
            for i = 0, 23 do
                local ang = i / 24 * math.pi * 2
                for _, rad in ipairs({ 3, 5, 7, 10, 14 }) do
                    local x, z = p.X + math.cos(ang) * rad, p.Z + math.sin(ang) * rad
                    if not inAttack(x, z, 2.5) then
                        local fromLight = Vector2.new(x - R.cx, z - R.cz).Magnitude
                        local d = rad * 0.5 + (fromLight > lightR and 100 + fromLight or fromLight * 0.2)
                        if not bestD or d < bestD then best, bestD = Vector3.new(x, p.Y, z), d end
                    end
                end
            end
            if best then
                moveTo(best)
                if os.clock() - (R.lastDodgeLog or 0) > 2 then
                    R.lastDodgeLog = os.clock()
                    roundLog("LightsOut: dodging a %s", tostring(a.k))
                end
            end
            state.gamesNote = "Lights Out: dodging the cat"
            return
        end
        if R.dark or (R.r or 0) <= 0 then
            stopMoving()
            state.gamesNote = "Lights Out: dark, standing still"
            return
        end
        local target = Vector3.new(R.cx, p.Y, R.cz)
        local d = flatDist(target, p)
        if inAttack(target.X, target.Z, 2) then
            stopMoving()
        elseif d > 1.5 then
            moveTo(target)
        else
            stopMoving()
        end
        state.gamesNote = string.format("Lights Out: in the light (%.1f studs from its centre)", d)
    end,
}

H.BumperPumpkins = {
    onEvent = function(ev, d)
        if ev == "setup" then
            if typeof(d.pivot) == "CFrame" then R.pivot = d.pivot end
            R.boostCd = tonumber(d.boostCd) or 2.5
        elseif ev == "phase" then R.phase = d.phase
        elseif ev == "boosted" then R.readyAt = tonumber(d.readyAt)
        elseif ev == "out" and d.id == (nightState() or {}).me then
            R.out = true
            roundLog("BumperPumpkins: knocked out")
        elseif ev == "car" and typeof(d) == "buffer" then
            R.decode(d)
        end
    end,
    tick = function()
        if R.out or R.phase == "ended" then return end
        if not R.decode then
            R.cars = {}
            R.decode = function(buf)
                if buffer.len(buf) < 16 or buffer.readu8(buf, 0) ~= 2 then return end
                local t = buffer.readf64(buf, 4)
                if t <= (R.carT or 0) then return end
                R.carT = t
                R.ringR = buffer.readu16(buf, 2) / 64
                R.ringX, R.ringZ = buffer.readi16(buf, 12) / 32, buffer.readi16(buf, 14) / 32
                local cars = {}
                for i = 0, buffer.readu8(buf, 1) - 1 do
                    local o = 16 + i * 8
                    if o + 8 > buffer.len(buf) then break end
                    cars[buffer.readi16(buf, o)] = { x = buffer.readi16(buf, o + 2) / 32, z = buffer.readi16(buf, o + 4) / 32, flags = buffer.readu8(buf, o + 7) }
                end
                R.cars = cars
            end
            local net = type(G.HG) == "table" and type(G.HG.NET) == "table" and G.HG.NET.CarStream or nil
            if net and isfn(G.Network, "UnreliableFired") then
                local ok, sig = gcall(G.Network.UnreliableFired, net)
                if ok and sig and type(sig.Connect) == "function" then
                    local mine = R
                    local conn
                    conn = sig:Connect(function(buf)
                        if R ~= mine then conn:Disconnect() return end
                        if typeof(buf) == "buffer" then pcall(mine.decode, buf) end
                    end)
                    track(conn)
                end
            end
        end
        if not (R.pivot and R.ringR) or R.phase == "dropin" then return end
        local me = (nightState() or {}).me
        local mineCar = R.cars and R.cars[me]
        if not mineCar then return end
        local function world(x, z) return R.pivot:PointToWorldSpace(Vector3.new(x, 0, z)) end
        local center = world(R.ringX, R.ringZ)
        local myPos = world(mineCar.x, mineCar.z)
        local fromCenter = flatDist(myPos, center)
        local safe = math.max(R.ringR - math.clamp(R.ringR * 0.3, 2.5, 8), 2)
        local function steer(v)
            v = flat(v)
            if v.Magnitude < 0.05 then return end
            v = v.Unit
            if not R.lastSteer or (R.lastSteer - v).Magnitude > 0.08 or os.clock() - (R.steerAt or 0) > 0.3 then
                R.lastSteer, R.steerAt = v, os.clock()
                nightInput("steer", { x = math.floor(v.X * 100) / 100, z = math.floor(v.Z * 100) / 100 })
            end
        end
        if fromCenter > safe then
            steer(center - myPos)
            state.gamesNote = string.format("Bumper Pumpkins: back to the middle (%.0f of %.0f studs)", fromCenter, R.ringR)
            return
        end
        local target, tD
        for id, c in pairs(R.cars or {}) do
            if id ~= me and bit32.band(c.flags or 0, 36) == 0 then
                local pos = world(c.x, c.z)
                local d = flatDist(pos, myPos)
                if flatDist(pos, center) < R.ringR - 1 and (not tD or d < tD) then target, tD = pos, d end
            end
        end
        if not target then
            steer(center - myPos)
            return
        end
        local out = flat(target - center)
        out = out.Magnitude > 0.1 and out.Unit or Vector3.new(1, 0, 0)
        local behind = target - out * 6
        steer(behind - myPos)
        local ready = serverNow() >= (R.readyAt or 0)
        if ready and tD <= 9 and fromCenter < safe - 2 then
            local dir = flat(target - myPos)
            if dir.Magnitude > 0.1 then
                dir = dir.Unit
                nightInput("boost", { x = math.floor(dir.X * 100) / 100, z = math.floor(dir.Z * 100) / 100 })
                R.readyAt = serverNow() + (R.boostCd or 2.5)
                roundLog("BumperPumpkins: bump at %.1f studs", tD)
            end
        end
        state.gamesNote = string.format("Bumper Pumpkins: hunting (%.0f studs away)", tD)
    end,
}

H.PumpkinColors = {
    onEvent = function(ev, d)
        if ev == "call" then
            R.safe = {}
            for _, i in ipairs(type(d.safe) == "table" and d.safe or {}) do R.safe[tonumber(i)] = true end
            R.endsAt = tonumber(d.endsAt)
            R.goal = nil
            roundLog("PumpkinColors: call %s, %d safe tiles", compact(d.called), #(type(d.safe) == "table" and d.safe or {}))
        elseif ev == "resolved" then
            R.safe = nil
            local me = (nightState() or {}).me
            for _, list in ipairs({ d.doomed or {}, d.out or {} }) do
                for _, id in ipairs(list) do if id == me then R.out = true roundLog("PumpkinColors: out") end end
            end
        elseif ev == "reset" or ev == "cleared" then R.safe = nil end
    end,
    tick = function()
        if R.out or not R.safe then return end
        local arena = arenaModel()
        local grid = arena and arena:FindFirstChild("ColorGrid")
        local root = hrp()
        if not (grid and root) then return end
        if not R.tiles then
            local list = {}
            for _, c in ipairs(grid:GetChildren()) do
                local col, row, layer = c.Name:match("^Tile_(%d+)_(%d+)_?(%d*)$")
                if col and c:IsA("BasePart") then list[#list + 1] = { part = c, c = tonumber(col), r = tonumber(row), l = tonumber(layer) or 0 } end
            end
            table.sort(list, function(x, y)
                if x.l ~= y.l then return x.l < y.l end
                if x.c ~= y.c then return x.c < y.c end
                return x.r < y.r
            end)
            R.tiles = list
        end
        local p = root.Position
        setControls(false)
        if not R.goal then
            local best, bestD
            for i, t in ipairs(R.tiles) do
                if R.safe[i] then
                    local part = t.part
                    local lp = part.CFrame:PointToObjectSpace(p)
                    local hx, hz = math.max(0, part.Size.X / 2 - 1.6), math.max(0, part.Size.Z / 2 - 1.6)
                    local spot = part.CFrame:PointToWorldSpace(Vector3.new(math.clamp(lp.X, -hx, hx), part.Size.Y / 2, math.clamp(lp.Z, -hz, hz)))
                    if math.abs(spot.Y - p.Y) < 14 then
                        local d = flatDist(spot, p)
                        if not bestD or d < bestD then best, bestD = spot, d end
                    end
                end
            end
            R.goal = best
        end
        if not R.goal then return end
        local d = flatDist(R.goal, p)
        local left = R.endsAt and (R.endsAt - serverNow()) or 99
        local h = humanoid()
        local speed = h and math.max(h.WalkSpeed, 1) or 16
        if d > 0.6 then
            if d / speed > left - 0.6 then
                teleportTo(R.goal + Vector3.new(0, 3, 0))
            else
                moveTo(Vector3.new(R.goal.X, p.Y, R.goal.Z))
            end
        else
            stopMoving()
        end
        state.gamesNote = string.format("Pumpkin Colors: %s safe tile (%.1fs left)", d > 0.6 and "walking to a" or "on a", left)
    end,
}

H.TrickOrTreatDoors = {
    onEvent = function(ev, d)
        R.bad = R.bad or {}
        R.taken = R.taken or {}
        if ev == "wave" then
            R.doors = {}
            for _, id in ipairs(type(d.doors) == "table" and d.doors or {}) do R.doors[#R.doors + 1] = tonumber(id) end
            R.phase = "sniff"
            R.committed = false
            R.taken = {}
        elseif ev == "pick" then
            R.phase = "pick"
            R.pickAt = os.clock()
        elseif ev == "taken" then R.taken[tonumber(d.doorId) or -1] = true
        elseif ev == "SniffHint" or ev == "lantern" then
            if d.doorId then R.bad[tonumber(d.doorId)] = true roundLog("TrickOrTreatDoors: door %s is a trick (hint)", tostring(d.doorId)) end
        elseif ev == "DoorRevealed" then
            if d.result == "trick" and d.doorId then R.bad[tonumber(d.doorId)] = true end
        elseif ev == "committed" then
            if d.id == (nightState() or {}).me then
                R.committed = true
                V.lastDoor = tonumber(d.doorId)
                roundLog("TrickOrTreatDoors: entered door %s", tostring(d.doorId))
            end
        elseif ev == "WaveResult" then
            R.phase = "done"
            local me = (nightState() or {}).me
            for _, id in ipairs(type(d.outIds) == "table" and d.outIds or {}) do if id == me then roundLog("TrickOrTreatDoors: the door was a trick, out") end end
        end
    end,
    tick = function()
        if R.phase ~= "pick" or R.committed then return end
        if os.clock() - (R.pickAt or 0) < 0.4 or os.clock() - (R.triedAt or 0) < 1 then return end
        local cands, fallback = {}, {}
        for _, id in ipairs(R.doors or {}) do
            if not R.bad[id] and not R.taken[id] then
                fallback[#fallback + 1] = id
                if id ~= V.lastDoor then cands[#cands + 1] = id end
            end
        end
        if #cands == 0 then cands = fallback end
        if #cands == 0 then return end
        local choice = cands[math.random(1, #cands)]
        local arena = arenaModel()
        local booths = arena and arena:FindFirstChild("DoorBooths")
        local door = booths and booths:FindFirstChild("Door" .. choice)
        local trig = door and door:FindFirstChild("Trigger")
        if not trig then return end
        R.triedAt = os.clock()
        teleportTo(trig.Position)
        task.wait(0.4)
        nightInput("CommitDoor", { doorId = choice })
        state.gamesNote = string.format("Haunted Doors: knocked on door %d (%d to pick from)", choice, #cands)
    end,
}

H.PumpkinSmash = {
    onEvent = function(ev, d)
        R.avoid = R.avoid or {}
        if ev == "setup" then R.r = tonumber(d.r) or 6
        elseif ev == "omen" or ev == "flare" then
            local m = d.m or (type(d.pos) == "table" and d.pos.m)
            if m then R.avoid[m] = { pos = type(d.pos) == "table" and Vector3.new(d.pos.x or d.pos[1] or 0, d.pos.y or d.pos[2] or 0, d.pos.z or d.pos[3] or 0) or (d.x and Vector3.new(d.x, d.y, d.z)) } end
        elseif ev == "pop" then
            if d.m then R.avoid[d.m] = nil end
        end
    end,
    tick = function()
        local arena = arenaModel()
        local folder = arena and arena:FindFirstChild("Pumpkins")
        local p = playerPos()
        if not (folder and p) then return end
        for m, a in pairs(R.avoid or {}) do
            if a.pos and dist(a.pos, p) < (R.r or 6) + 3 then
                local v = p - a.pos
                v = Vector3.new(v.X, 0, v.Z)
                v = v.Magnitude > 0.1 and v.Unit or Vector3.new(1, 0, 0)
                teleportTo(p + v * ((R.r or 6) + 5))
                state.gamesNote = "Pumpkin Smash: dodging a Jack Bomb"
                return
            end
        end
        local best, bestD
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("Model") and (child:GetAttribute("Health") or 1) > 0 then
                local body = child:FindFirstChild("Body")
                local marker = child:GetAttribute("Marker")
                if body and body:IsA("BasePart") and not body:FindFirstChild("Ember") and not (R.avoid and marker and R.avoid[marker]) then
                    local d = dist(body.Position, p)
                    if not bestD or d < bestD then best, bestD = child, d end
                end
            end
        end
        if not best then state.gamesNote = "Pumpkin Smash: no pumpkin left" return end
        local body = best:FindFirstChild("Body")
        if bestD > 5 then
            local dir = body.Position - p
            dir = Vector3.new(dir.X, 0, dir.Z)
            dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.new(0, 0, 1)
            teleportTo(Vector3.new(body.Position.X, p.Y, body.Position.Z) - dir * 3)
        end
        if os.clock() - (R.lastPunch or 0) >= 0.26 then
            R.lastPunch = os.clock()
            nightInput("punch", { m = best:GetAttribute("Marker") })
            state.gamesNote = "Pumpkin Smash: smashing pumpkin " .. tostring(best:GetAttribute("Marker"))
        end
    end,
}

H.CoffinChairs = {
