H.TombstoneBridge = {
    onEvent = function(ev, d)
        R.known = R.known or {}
        local me = (nightState() or {}).me
        if ev == "warmup" or ev == "start" then
            if tonumber(d.endsAt) then R.endsAt = tonumber(d.endsAt) end
            if tonumber(d.rows) then R.rows = tonumber(d.rows) end
            if ev == "start" then
                R.progress = R.progress or 0
                R.rowSince = os.clock()
                roundLog("bridge: I am contestant %s, %d rows, %.0fs on the clock", tostring(me), R.rows or 12, R.endsAt and (R.endsAt - serverNow()) or -1)
            end
        elseif ev == "progress" then
