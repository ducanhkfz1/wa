V.missingModules = {}
local function req(path, quiet)

    local ok, mod
    local tries = 0
    repeat
        ok, mod = gcall(function()
            local node = RS
            for seg in string.gmatch(path, "[^%.]+") do
                node = node:FindFirstChild(seg)
                if not node then error("missing " .. path) end
            end
            return require(node)
        end)
        tries += 1
        if not ok and os.clock() - K.BOOT_CLOCK < 8 and tries < 4 then task.wait(0.4) else break end
    until ok
    if ok then return mod end
    if not quiet then V.missingModules[#V.missingModules + 1] = path:gsub("^Library%.", "") end
    return nil
end

