            R.faces = {}
            for _, f in ipairs(d.faces) do
                if type(f) == "table" and type(f.s) == "number" and type(f.f) == "string" then R.faces[f.s] = f.f end
            end
            R.started = false
        elseif ev == "cleared" and d.id == (nightState() or {}).me then
            R.done = true
        end
    end,
    tick = function()
        if R.done or R.started or not R.faces then return end
        local st = nightState()
        local arena = arenaModel()
        local plots = arena and arena:FindFirstChild("Plots")
        if not (plots and st) then return end
        local plot
        for _, c in ipairs(plots:GetChildren()) do
            if c:GetAttribute("Owner") == st.me then plot = c break end
        end
        local stones = plot and plot:FindFirstChild("Stones")
        if not stones then return end
        local byIndex = {}
        for _, s in ipairs(stones:GetChildren()) do
            local i = tonumber(s:GetAttribute("Index"))
            if i then byIndex[i] = s end
        end
        local groups = {}
        for i, face in pairs(R.faces) do
            groups[face] = groups[face] or {}
            table.insert(groups[face], i)
