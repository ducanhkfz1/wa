end
local function findAutoexecFile()
    if V.autoexecFile ~= nil then return V.autoexecFile or nil end
    V.autoexecFile = false
    if type(listfiles) ~= "function" or type(readfile) ~= "function" then return nil end
    for _, folder in ipairs({ "autoexec", "autoexecute", "AutoExec", "autoexecs" }) do
        local ok, files = pcall(listfiles, folder)
        if ok and type(files) == "table" then
            for _, path in ipairs(files) do
                local okR, body = pcall(readfile, path)
                if okR and type(body) == "string" and (body:find("VyHalloweenGames", 1, true) or body:find("VY_HalloweenGames", 1, true)) then
                    V.autoexecFile = path
                    return path
                end
            end
        end
    end
    return nil
end

