    local list = {}
    for word in string.gmatch(tostring(text or ""), "[^,]+") do
        local w = word:gsub("^%s+", ""):gsub("%s+$", ""):gsub("%s", "")
        local u = K.UPGRADE_BY_KEY[w] or K.UPGRADE_BY_KEY[string.lower(w)]
