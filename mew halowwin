local function zoneCount()
    local obj = instanceObject()
    local n = 0
    if obj and type(obj.instanceZones) == "table" then
        for k in pairs(obj.instanceZones) do if type(k) == "number" and k > n then n = k end end
    end
    if n == 0 then n = inEvent() and #K.ZONES or 1 end
    return n
end
local function zoneUnlocked(n)
    if n <= 1 then return true end
    if isfn(G.InstanceZone, "IsUnlocked") then
        local v = gval(G.InstanceZone.IsUnlocked, n)
        if v ~= nil then return v == true end
    end
    local s = getSave()
    local id = activeInstanceId()
    local iv = s and s.InstanceVars and id and s.InstanceVars[id]
    local iz = iv and iv.InstanceZones
    return type(iz) == "table" and iz["__Zone_" .. n] == true
end
local function bestZoneNumber()
    if isfn(G.InstanceZone, "GetMaximumOwnedZoneNumber") then
        local n = gval(G.InstanceZone.GetMaximumOwnedZoneNumber)
        if type(n) == "number" and n >= 1 then return math.clamp(n, 1, math.max(1, zoneCount())) end
    end
    local best = 1
    for i = 2, zoneCount() do
        if zoneUnlocked(i) then best = i end
    end
    return best
end
local function zoneInfo(n)
    local obj = instanceObject()
    local z = obj and type(obj.instanceZones) == "table" and obj.instanceZones[n] or nil
    if type(z) ~= "table" then return nil end
    return { number = n, name = z.DisplayName, cost = tonumber(z.CurrencyCost), currency = z.CurrencyId }
