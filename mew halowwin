local function enterEvent()
    if inEvent() then return true end
    if placeKind() ~= "world" then return true end
    if not eventAvailable() then return false, "the Halloween Games event is not in this game version" end
    if not isfn(G.Instancing, "Enter") then return false, "InstancingCmds.Enter missing" end
    log("entering the Halloween Games")
    if canSetIdentity then pcall(setthreadidentity, 2) end
