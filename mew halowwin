            local id = tonumber(string.match(c.Name, "^C(%d+)$"))
            if id and c:IsA("Model") then
                coffins[#coffins + 1] = { id = id, model = c, seat = c:FindFirstChild("Seat"), zone = c:FindFirstChild("ClaimZone") }
            end
        end
        local function spot(c)
            return partPos(c.seat) or partPos(c.zone) or partPos(c.model)
        end

        local function isOpen(c)
            local lid, shut = c.model:FindFirstChild("Lid"), c.model:FindFirstChild("LidShut")
            if not (lid and shut) then return true end
            local lp, sp = partPos(lid), partPos(shut)
            if not (lp and sp) then return true end
            return dist(lp, sp) > 0.6
        end
        local function usable(c)
            if R.active and next(R.active) ~= nil and not R.active[c.id] then return false end
            if R.taken and R.taken[c.id] then return false end
            if c.id == R.flicker then return false end
            if R.phase == "claim" then
                if R.opened and next(R.opened) ~= nil then return R.opened[c.id] == true end
                return isOpen(c)
            end
            if R.soon and next(R.soon) ~= nil then return R.soon[c.id] == true end
            return true
        end
        local function ringCenter()
            if R.center then return R.center, R.radius end
            local sum, n, far = Vector3.zero, 0, 0
            for _, c in ipairs(coffins) do
                local sp = spot(c)
                if sp then sum += sp n += 1 end
            end
            if n == 0 then return nil end
            local center = sum / n
            for _, c in ipairs(coffins) do
                local sp = spot(c)
                if sp then far = math.max(far, Vector3.new(sp.X - center.X, 0, sp.Z - center.Z).Magnitude) end
            end
            R.center, R.radius = center, math.max(far, 8)
            return center, R.radius
        end
        setControls(false)
        local rushing = R.phase ~= "claim" and R.soon ~= nil and next(R.soon) ~= nil
        if (R.phase == "claim" or rushing) and not R.seated then
            local best, bestD
            for _, c in ipairs(coffins) do
                if usable(c) then
                    local s = spot(c)
                    local d = s and dist(s, p) or math.huge
                    if s and (not bestD or d < bestD) then best, bestD = c, d end
                end
            end
            if not best then state.gamesNote = "Coffin Chairs: no open coffin left" return end
            local s = spot(best)
            if os.clock() - (R.lastClaim or 0) > 0.2 then
                R.lastClaim = os.clock()
                R.claimTries = (R.claimTarget == best.id) and (R.claimTries or 0) + 1 or 1
                R.claimTarget = best.id
                local h = humanoid()
                local seat = best.seat
                local c = LocalPlayer.Character
                local standing = R.claimTries % 2 == 0 and not rushing
                if standing then
                    if h then h.Sit = false end
                    teleportTo(s + Vector3.new(0, 2.5, 0))
                elseif seat and seat:IsA("Seat") and h then
                    teleportTo(seat.Position + Vector3.new(0, 2, 0))
                    pcall(seat.Sit, seat, h)
                else
                    local cf = (seat and seat:IsA("BasePart")) and seat.CFrame or CFrame.new(s)
                    if c then pcall(function() c:PivotTo(cf + Vector3.new(0, 1, 0)) end) end
                    if h then h.Sit = true end
                end
                task.wait(0.1)
                nightInput("claim", { coffin = best.id })
                local root = hrp()
                roundLog("coffin claim %d try %d (%s%s) me=%s seat=%s dist=%.1f", best.id, R.claimTries, standing and "standing" or "seated", rushing and ", early" or "", root and tostring(root.Position) or "?", tostring(s), root and dist(root.Position, s) or -1)
                state.gamesNote = string.format("Coffin Chairs: claiming coffin %d (try %d)", best.id, R.claimTries)
            end
        elseif R.phase == "promenade" or R.phase == "arrival" then
            local center, radius = ringCenter()
            if not center then return end
            local soon
            if R.soon and next(R.soon) ~= nil then
                local bestD
                for _, c in ipairs(coffins) do
                    if R.soon[c.id] and usable(c) then
                        local sp = spot(c)
                        local d = sp and dist(sp, p) or math.huge
                        if sp and (not bestD or d < bestD) then soon, bestD = c, d end
                    end
                end
            end
            R.angle = R.angle or math.atan2(p.Z - center.Z, p.X - center.X)
            local target
            if soon then
                local sp = spot(soon)
                local toC = Vector3.new(center.X - sp.X, 0, center.Z - sp.Z)
                toC = toC.Magnitude > 0.1 and toC.Unit or Vector3.new(0, 0, 1)
                local side = Vector3.new(-toC.Z, 0, toC.X)
                R.orbit = R.orbit or 0
                target = sp + toC * 4 + side * (3 * math.sin(R.orbit))
                if dist(Vector3.new(target.X, p.Y, target.Z), p) < 2 then R.orbit += 1.6 end
                state.gamesNote = "Coffin Chairs: circling coffin " .. soon.id
            else
                local r = radius * 0.6
                target = Vector3.new(center.X + math.cos(R.angle) * r, p.Y, center.Z + math.sin(R.angle) * r)
                if dist(Vector3.new(target.X, p.Y, target.Z), p) < 3 then R.angle += 0.5 end
                state.gamesNote = "Coffin Chairs: walking the ring"
            end
            if dist(Vector3.new(target.X, p.Y, target.Z), p) > 45 then teleportTo(target + Vector3.new(0, 2, 0)) end
            moveTo(Vector3.new(target.X, p.Y, target.Z))
        end
    end,
}

H.GravestoneMemory = {
    onEvent = function(ev, d)
