local function combineDir()
    local all = type(G.Directory) == "table" and rawget(G.Directory, "HalloweenCraftingMachines") or nil
    if all == nil and type(G.Directory) == "table" then
        local ok, v = pcall(function() return G.Directory.HalloweenCraftingMachines end)
        all = ok and v or nil
    end
    return type(all) == "table" and all[K.COMBINE_ID] or nil
end
local function ingredientNeed(dir, ing)
    local amount = tonumber(flagValue(ing.AmountFFlag)) or tonumber(ing.Amount) or 1
    local need = math.max(1, math.ceil(amount))
    if not ing.NoDiscount and type(dir.IngredientAmount) == "function" then
        local ok, v = pcall(dir.IngredientAmount, nil, need)
        if ok and type(v) == "number" and v == v then need = math.max(1, math.ceil(v)) end
    end
    return need
end
local function ingredientHave(dir, ing)
    local okC, have = gcall(function()
        local item = ing.Item:Clone()
        local n = item:CountAny()
        if dir.AnyVariantInputs and item:IsA("Pet") then
            for _, v in ipairs({ "Golden", "Rainbow" }) do
                local c = item:Clone()
                if c["CanBe" .. v](c) then
                    c["Set" .. v](c)
                    n += c:CountAny()
                end
            end
            if item:CanBeShiny() then
                for _, v in ipairs({ "Normal", "Golden", "Rainbow" }) do
                    local c = item:Clone()
                    local ok = v == "Normal" or (v == "Golden" and c:CanBeGolden()) or (v == "Rainbow" and c:CanBeRainbow())
                    if ok then
                        if v ~= "Normal" then c["Set" .. v](c) end
                        c:SetShiny(true)
                        n += c:CountAny()
                    end
                end
            end
        end
        return n
    end)
    return okC and tonumber(have) or 0
end
local function combineRecipes()
    local dir = combineDir()
    local out = {}
    if not dir or type(dir.Recipes) ~= "table" then return out, dir end
    for i, r in ipairs(dir.Recipes) do
        if type(r) == "table" and r.Result and type(r.Ingredients) == "table" and r.Hidden ~= true then
            local name = tostring(gval(function() return r.Result:GetId() end) or ("Recipe " .. i))
            local open = r.EnabledFFlag == nil or flagValue(r.EnabledFFlag) ~= false
            local ready, missing = true, {}
            for _, ing in ipairs(r.Ingredients) do
                local need, have = ingredientNeed(dir, ing), ingredientHave(dir, ing)
                if have < need then
                    ready = false
                    missing[#missing + 1] = string.format("%s %d/%d", tostring(gval(function() return ing.Item:GetId() end) or "?"), have, need)
                end
            end
            out[#out + 1] = { index = i, name = name, open = open, ready = ready, missing = table.concat(missing, ", "), duration = tonumber(flagValue(r.DurationFFlag)) or tonumber(r.Duration) }
        end
    end
    return out, dir
end
local function combineMachineStand()
    local m = instanceModel()
    local inter = m and m:FindFirstChild("INTERACT")
    local machines = inter and inter:FindFirstChild("Machines")
    local mach = machines and machines:FindFirstChild(K.COMBINE_MACHINE)
    if not mach then return nil end
    local pad = mach:FindFirstChild("Pad", true)
    if pad and pad:IsA("BasePart") then return pad.Position + Vector3.new(0, 3, 0) end
    return mach:GetPivot().Position + Vector3.new(0, 3, 6)
end
local function combineRun(force)
    if not force and os.clock() < V.combineNextAt then return end
    V.combineNextAt = os.clock() + 20
    if isfn(G.HGForge, "CombineMode") and gval(G.HGForge.CombineMode) == false then
        state.combineNote = "the Combine-o-Matic is closed right now"
        return
    end
    local recipes, dir = combineRecipes()
    if not dir then
        state.combineNote = "Combine-o-Matic not found in this game version"
        logOnce("combine-nodir", "Combine-o-Matic: machine not found in the game data")
        return
    end
    local okQ, queue = netInvoke("HalloweenCraftingMachine_GetQueue")
    if not okQ or type(queue) ~= "table" then
        state.combineNote = "could not read the craft queue"
        return
    end
    local queued, claims = {}, {}
    for _, e in ipairs(queue) do
        if type(e) == "table" and (e.MachineId == nil or e.MachineId == dir._id) and e.RecipeIndex then
            queued[e.RecipeIndex] = e
            if (tonumber(e.Remaining) or 0) <= 0 and e.UID then claims[#claims + 1] = e end
        end
    end
    local starts, waiting = {}, {}
    for i = #recipes, 1, -1 do
        local r = recipes[i]
        local picked = F.combinePick == nil or F.combinePick[r.name] == true
        if picked and r.open and not queued[r.index] then
            if r.ready then starts[#starts + 1] = r else waiting[#waiting + 1] = r.name .. " needs " .. r.missing end
        elseif picked and queued[r.index] and (tonumber(queued[r.index].Remaining) or 0) > 0 then
            waiting[#waiting + 1] = string.format("%s crafting, %s left", r.name, shorten(tonumber(queued[r.index].Remaining) or 0) .. "s")
        end
    end
    if #claims == 0 and #starts == 0 then
        state.combineNote = #waiting > 0 and waiting[1] or "nothing to craft from your picked recipes"
        return
    end
    if not holdExcursion("combine", 20) then return end
    local before = playerPos()
    pcall(function()
        local stand = combineMachineStand()
        if stand then
            teleportTo(stand)
            task.wait(0.8)
        end
        for _, e in ipairs(claims) do
            local ok, res, msg = netInvoke("HalloweenCraftingMachine_Claim", e.UID)
            local name = "recipe " .. tostring(e.RecipeIndex)
            for _, r in ipairs(recipes) do if r.index == e.RecipeIndex then name = r.name end end
            if ok and res then
                state.combineClaimed += 1
                state.combineNote = "claimed " .. name
                log("Combine-o-Matic: claimed %s", name)
                notify("Combine-o-Matic", "Claimed " .. name, 6)
            else
                logOnce("combine-claim-" .. tostring(msg or res), "Combine-o-Matic: claim of %s refused: %s", name, tostring(msg or res))
            end
            task.wait(0.6)
        end
        for _, r in ipairs(starts) do
            local again = combineRecipes()
            local fresh
            for _, x in ipairs(again) do if x.index == r.index then fresh = x end end
            if fresh and fresh.ready then
                local ok, res, msg = netInvoke("HalloweenCraftingMachine_StartCraft", dir._id, r.index)
                if ok and res then
                    state.combineStarted += 1
                    state.combineNote = string.format("crafting %s (%s)", r.name, r.duration and (shorten(r.duration / 60) .. " min") or "?")
                    log("Combine-o-Matic: started %s, ready in %s minutes", r.name, r.duration and tostring(math.floor(r.duration / 60)) or "?")
                    notify("Combine-o-Matic", "Crafting " .. r.name, 6)
                else
                    state.combineNote = "start refused: " .. tostring(msg or res)
                    logOnce("combine-start-" .. tostring(msg or res), "Combine-o-Matic: %s refused: %s", r.name, tostring(msg or res))
                end
                task.wait(math.max(1, tonumber(dir.Cooldowns and dir.Cooldowns[1]) or 1) + 0.2)
            end
        end
    end)
    if before and state.alive then teleportTo(before) end
    releaseExcursion("combine")
    V.combineNextAt = os.clock() + 8
end

