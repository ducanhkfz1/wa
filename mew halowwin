end

local function gamesTick()

    if placeKind() == "lobby" and (F.autoQueue or F.autoGames) then
        local models = workspace:FindFirstChild("Models") or workspace:FindFirstChild("LOBBY")
        local pad = models and models:FindFirstChild("Pad")
        local part = pad and (pad:FindFirstChild("Pad") or pad)
        local target = partPos(part)
        target = target and (target + Vector3.new(0, 3, 0)) or K.LOBBY_QUEUE
        local p = playerPos()
        if p and dist(Vector3.new(p.X, 0, p.Z), Vector3.new(target.X, 0, target.Z)) > 12 and os.clock() - (V.g.lastPadTp or 0) > 3 then
            V.g.lastPadTp = os.clock()
            teleportTo(target)
            log("lobby: standing on the queue pad")
        end
        V.g.idleSince = V.g.idleSince or os.clock()
        state.gamesNote = string.format("in the Halloween lobby, queued on the pad (%ds)", math.floor(os.clock() - V.g.idleSince))
        state.status = "Halloween Games: " .. state.gamesNote
        if F.autoGames and os.clock() - V.g.idleSince > 420 then goHome("no match started for 7 minutes") end
        return
    end
    if not (F.autoGames and (inEvent() or placeKind() ~= "world")) then
        if state.excursion == "games" then releaseExcursion("games") end
        setControls(true)
        if V.g.spoof then setDevMarkers(false) end
        return
    end
    if state.excursion ~= nil and state.excursion ~= "games" then return end
    state.excursion = "games"
    local st = nightState()
    if st and st.nightId ~= nil and st.phase ~= "ended" then
        V.g.idleSince = nil
        if not V.g.spoof then setDevMarkers(true) end
        if st.roundId ~= V.g.round then
            resetRound(st.roundId)
            if st.roundId then log("round %s (%s)", tostring(st.roundId), tostring(st.config and st.config.DisplayName or "")) end
        end
        if V.g.round and V.g.enabledFor ~= V.g.round and (st.phase == "play" or st.phase == "title") then
            local r = enableBuiltin(V.g.round)
            if r ~= nil then V.g.enabledFor = V.g.round if r then log("built-in autoplay on for %s", V.g.round) else warnlog("built-in autoplay refused for %s", V.g.round) end end
            if r == nil then V.g.enabledFor = V.g.round end
        end
        local me = nightMe()
        local out = st.out == true or (type(me) == "table" and me.Alive == false and st.match == true)
        if out then
            V.g.outSince = V.g.outSince or os.clock()
            local since = os.clock() - V.g.outSince
            if F.gamesLeaveWhenOut then

                if since > 3 and not V.g.exitPressed then
                    V.g.exitPressed = true
                    local pressed = isfn(G.HGMatch, "Press") and gval(G.HGMatch.Press, "Exit")
                    if pressed ~= true and isfn(G.HGNight, "Leave") then pcall(G.HGNight.Leave) end
                    log("eliminated, leaving the night")
                end
                if since > 15 and not V.g.matchExitSent then
                    V.g.matchExitSent = true
                    if isfn(G.HGNight, "MatchExit") then pcall(G.HGNight.MatchExit) end
                end
                if since > 45 and placeKind() ~= "world" then goHome("eliminated and still in the match place") end
            end
            state.gamesNote = "eliminated" .. (F.gamesLeaveWhenOut and ", leaving" or ", spectating")
        else
            V.g.outSince, V.g.exitPressed, V.g.matchExitSent = nil, nil, nil
        end
        if st.phase ~= "play" then
            state.gamesNote = string.format("Night %s: %s%s", tostring(st.number), tostring(st.roundId or st.phase), st.phase ~= "play" and (" (" .. tostring(st.phase) .. ")") or "")
        end
        state.status = "playing the Halloween Games: " .. tostring(state.gamesNote)
        return
    end

    if st and st.phase == "ended" and st.lastEnd and V.g.lastEndSeen ~= st.lastEnd then
        V.g.lastEndSeen = st.lastEnd
        local d = st.lastEnd
        if type(d) == "table" then
            log("night over: placement %s, payout %s treats (%s)", tostring(d.placement), tostring(d.payout), tostring(d.why or "finished"))
            notify("Halloween Games", string.format("Night done: place %s, %s treats", tostring(d.placement), tostring(d.payout)), 5)
        end
    end
    if V.g.spoof then setDevMarkers(false) end
    V.g.round, V.g.arena = nil, nil
    setControls(true)
    if placeKind() ~= "world" then
        V.g.idleSince = V.g.idleSince or os.clock()
        if pickNight() then return end
        local idle = os.clock() - V.g.idleSince
        state.gamesNote = string.format("in the match place, waiting for the night to begin (%ds)", math.floor(idle))
        state.status = "Halloween Games: " .. state.gamesNote
        if idle > 420 then goHome("no match started for 7 minutes") end
        return
    end
    V.g.idleSince = nil
    if pickNight() then return end
    local p = playerPos()
    if p and dist(p, K.HUB_STAND) > 6 and os.clock() - (V.g.lastPadTp or 0) > 2 then
        V.g.lastPadTp = os.clock()
        teleportTo(K.HUB_STAND)
    end
    local c = V.g.circle
    if c and c.phase == "countdown" then
        state.gamesNote = string.format("Night %s starts soon", tostring(c.night))
    elseif c and c.phase == "wait" and os.clock() - c.at < 15 then
        state.gamesNote = "every arena is busy, waiting"
    else
        state.gamesNote = "waiting on the pad for the next night"
    end
    state.status = "Halloween Games: " .. state.gamesNote
end

F.autoForge = false
F.forgeShards = true
F.forgeKeepEquipped = false
F.forgeMinChance = 5
K.FORGE_PAD = Vector3.new(-5982.4, 13.7, -4036.0)
V.forgeNextAt = 0
state.forgeNote = "-"

local function forgeFlag(name)
    if isfn(G.HGForge, "flag") then return gval(G.HGForge.flag, name) end
    return nil
end
local function forgeState()
    if not isfn(G.HGForge, "State") then return nil end
    local st = gval(G.HGForge.State)
    if type(st) ~= "table" and isfn(G.HGForge, "Fetch") then st = gval(G.HGForge.Fetch) end
    return type(st) == "table" and st or nil
end

local function forgeRungs(st)
    local dials, closed, why = {}, {}, nil
    local targets = type(G.ForgeUtil) == "table" and G.ForgeUtil.TARGETS or {}
    for id, t in pairs(targets) do
        local v = st and st[id]
        local hasLimit = type(v) == "table" and type(v.limit) == "number" and v.limit >= 0
        if type(v) == "table" and forgeFlag(t.Enabled) == true and v.open and type(v.dial) == "number" and type(v.left) == "number" and (not hasLimit or type(v.used) == "number") then
            if v.left <= 0 then closed[id] = true why = why or "sold out"
            elseif hasLimit and v.used >= v.limit then closed[id] = true why = why or "limit reached"
            else dials[id] = v.dial end
        else
            closed[id] = true
            why = why or "closed"
        end
    end
    return dials, closed, why
end
local function equippedUidSet()
    local set = {}
    if isfn(G.PetCmds, "GetEquippedItems") then
        local ok, items = gcall(G.PetCmds.GetEquippedItems)
        if ok and type(items) == "table" then
            for _, it in pairs(items) do
                if type(it) == "string" then set[it] = true
                else
                    local okU, uid = pcall(function() return it:GetUID() end)
                    if okU and uid then set[uid] = true end
                end
            end
        end
    end
    return set
end

local function forgeCandidates()
    local out = {}
    if not (type(G.ForgeUtil) == "table" and type(G.ForgeUtil.Inputs) == "function" and type(G.Items) == "table") then return out end
    local inputs = gval(G.ForgeUtil.Inputs, G.HGForge.flag) or {}
    local equipped = equippedUidSet()
    local ok, all = gcall(function() return G.Items.Pet:All() end)
    if not (ok and type(all) == "table") then return out end
    for uid, item in pairs(all) do
        local okI, info = pcall(function()
            return { id = item:GetId(), amount = item:GetAmount(), variant = (item:IsGolden() or item:IsRainbow() or item:IsShiny()) and 1 or 0 }
        end)
        if okI and info and inputs[info.id] and (info.amount or 0) > 0 then
            if equipped[uid] and F.forgeKeepEquipped then
                V.forgeSkippedEquipped = (V.forgeSkippedEquipped or 0) + info.amount
            else
                out[#out + 1] = { uid = uid, id = info.id, amount = info.amount, power = inputs[info.id], variant = info.variant }
            end
        end
    end
    table.sort(out, function(a, b)
        if a.power ~= b.power then return a.power < b.power end
        if a.variant ~= b.variant then return a.variant < b.variant end
        return a.amount > b.amount
    end)
    return out
end

local function forgePlan()
    local st = forgeState()
    if not st then return nil, "forge state not loaded" end

    local dials, closed, why = forgeRungs(st)
    V.forgeSkippedEquipped = 0
    local cands = forgeCandidates()
    if #cands == 0 then
        if (V.forgeSkippedEquipped or 0) > 0 then return nil, string.format("your %d event pets are all equipped (Keep Equipped Pets is on)", V.forgeSkippedEquipped) end
        local okI, inputs = gcall(G.ForgeUtil.Inputs, G.HGForge.flag)
        local n = 0
        for _ in pairs(okI and inputs or {}) do n += 1 end
        return nil, string.format("no event pets to roll (the Forge accepts %d pet types)", n)
    end
    local shards = 0
    if F.forgeShards and isfn(G.HGForge, "Shards") and type(G.ForgeUtil.ShardCap) == "function" then
        shards = math.min(gval(G.HGForge.Shards) or 0, gval(G.ForgeUtil.ShardCap, G.HGForge.flag) or 0)
    end
    local counts, pets, used = {}, {}, 0
    local best
    for _, c in ipairs(cands) do
        local take = c.amount
        counts[c.id] = (counts[c.id] or 0) + take
        pets[c.uid] = take
        local ok, tbl = gcall(G.ForgeUtil.Table, G.HGForge.flag, counts, shards, dials, closed)
        if not (ok and type(tbl) == "table") then return nil, "forge table error: " .. tostring(tbl) end
        if tbl.overflow or #tbl.rows == 0 then
            counts[c.id] -= take
            if counts[c.id] <= 0 then counts[c.id] = nil end
            pets[c.uid] = nil
            if #tbl.rows == 0 then
                if used == 0 then return nil, "nothing to win above your best pet" .. (why and (" (" .. why .. ")") or "") end
                break
            end
        else
            used += take
            best = tbl
            if tbl.capped then break end
        end
    end
    if not best or used == 0 then return nil, "nothing to roll (pets above the ladder or odds capped)" end
    return { pets = pets, shards = shards, total = best.total, used = used, miss = best.missShards, closedWhy = why }, nil
end
