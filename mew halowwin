task.spawn(function()
    pcall(rememberLoader)
    local resume = loadResume()
    if resume and type(resume.flags) == "table" then
        task.wait(1)
        local function apply(name, value)
            local setter = Library.SetFlags and Library.SetFlags[name]
            if type(setter) == "function" then pcall(setter, value) end
            if name == "hg_autoGames" then F.autoGames = value == true end
            if name == "hg_autoQueue" then F.autoQueue = value ~= false end
        end
        for name, value in pairs(resume.flags) do
            if name ~= "hg_autoGames" then apply(name, value) end
        end
        if resume.flags.hg_autoGames ~= nil then apply("hg_autoGames", resume.flags.hg_autoGames) end
        if tonumber(resume.home) then V.homePlace = tonumber(resume.home) end
        log("landed in the %s place, settings restored (%s)", placeKind(), tostring(resume.reason or "?"))
    end
    if placeKind() ~= "world" then
        if not F.autoGames then
            F.autoGames = true
            pcall(function() if Library.SetFlags and Library.SetFlags.hg_autoGames then Library.SetFlags.hg_autoGames(true) end end)
            log("in the Halloween %s place: Auto Halloween Games is on", placeKind())
        end
        state.status = "in the Halloween " .. placeKind() .. " place"
        notify("MEW HUB", "Halloween Games: in the " .. placeKind() .. " place", 5)
        return
    end
    if eventAvailable() then
        local ok, err = enterEvent()
        if ok then
            state.status = "inside the Halloween Games"
            notify("MEW HUB", "Halloween Games loaded - RightShift opens the menu", 6)
        else
            state.status = "not inside the Halloween Games (" .. tostring(err) .. "): Universal Mode"
            notify("MEW HUB", "Could not enter the Halloween Games (" .. tostring(err) .. "). Universal Mode is on: enter any event instance", 8)
            F.universalMode = true
            pcall(function() if Library.SetFlags and Library.SetFlags.hg_universal then Library.SetFlags.hg_universal(true) end end)
        end
    else
        state.mode = "universal"
        F.universalMode = true
        pcall(function() if Library.SetFlags and Library.SetFlags.hg_universal then Library.SetFlags.hg_universal(true) end end)
        state.status = "event not found in this game version: Universal Mode"
        notify("MEW HUB", "Halloween Games not found: Universal Mode is on, enter any event instance", 8)
    end
end)

