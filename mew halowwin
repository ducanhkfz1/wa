local function queueReexec()
    if type(queue_on_teleport) ~= "function" then logOnce("noqueue", "queue_on_teleport missing: the script cannot restart itself after a teleport") return end
    if V.reexecQueued then return end
    if genv.VyHGQueuedJob == game.JobId then V.reexecQueued = true return end
    local loader = rememberLoader()
    local hosted = isLoaderLink(loader)
    local autoexec = findAutoexecFile()
    local hasFile = type(isfile) == "function" and select(2, pcall(isfile, K.RUN_FILE)) == true
    if not hosted and not autoexec and not hasFile then
        logOnce("noreexec", "no loader link, autoexec file or local copy: the script cannot restart after a teleport")
        return
    end
    V.reexecQueued = true
    local key = type(script_key) == "string" and script_key or ""
    local chunk = string.format([[
print("[VY HalloweenGames] restarting after the teleport (queued copy)")
if not game:IsLoaded() then game.Loaded:Wait() end
while not game:GetService("Players").LocalPlayer do task.wait(0.2) end
task.wait(2)
local src, lastErr
if %s then
    script_key = %q
    getgenv().VyHalloweenGamesLoader = %q
    for attempt = 1, 6 do
        local ok, body = pcall(game.HttpGet, game, %q)
        if ok and type(body) == "string" and #body > 50 then src = body break end
        lastErr = ok and ("empty answer") or tostring(body)
        warn("[VY HalloweenGames] loader attempt " .. attempt .. " of 6 failed: " .. lastErr)
        task.wait(4)
    end
end
local autoexec = %q
if not src and autoexec ~= "" and type(isfile) == "function" and isfile(autoexec) then src = readfile(autoexec) end
if not src and type(isfile) == "function" and isfile(%q) then src = readfile(%q) end
if src then
    local f, err = loadstring(src, "=VY_HalloweenGames")
    if f then f() else warn("[VY HalloweenGames] could not compile after the teleport: " .. tostring(err)) end
else
    warn("[VY HalloweenGames] could not restart after the teleport (" .. tostring(lastErr or "nothing to load") .. "), execute the script again")
end
]], hosted and "true" or "false", key, tostring(loader), tostring(loader), autoexec or "", K.RUN_FILE, K.RUN_FILE)
    pcall(queue_on_teleport, chunk)
    genv.VyHGQueuedJob = game.JobId
    log("restart after teleport queued (%s)", hosted and "loader link" or autoexec and "autoexec file" or "local file")
end

