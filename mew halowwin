local function zonePos(n)
    if inEvent() and K.ZONES[n] then return K.ZONES[n].Pos end
    local m = instanceModel()
    local tp = m and m:FindFirstChild("Teleports")
    local part = tp and tp:FindFirstChild(tostring(n))
    if part and part:IsA("BasePart") then return part.Position + Vector3.new(0, 3, 0) end
    local bz = m and m:FindFirstChild("BREAK_ZONES")
    local zp = bz and bz:FindFirstChild("Zone" .. n)
    if zp and zp:IsA("BasePart") then return zp.Position + Vector3.new(0, 4, 0) end
    return nil
end
local function zoneName(n)
    if inEvent() and K.ZONES[n] then return K.ZONES[n].Name end
    local info = zoneInfo(n)
    return string.format("#%d %s", n, info and info.name or "Zone")
end

