local function resetRound(roundId)
    V.g.round = roundId
    V.g.roundAt = os.clock()
    R = {}
    V.g.enabledFor = nil
    setControls(true)
end
local function onRoundEvent(roundId, event, data, t)
    if not (state.alive and F.autoGames) then return end
    if roundId ~= V.g.round then resetRound(roundId) roundLog("== round %s me=%s", tostring(roundId), tostring((nightState() or {}).me)) end
    if K.LOGGED_ROUNDS[roundId] and not (roundId == "LightsOut" and event == "state") then
        roundLog("%s %s %s", tostring(roundId), tostring(event), typeof(data) == "buffer" and "<buffer>" or compact(data))
    end
    local h = H[roundId]
    if h and type(h.onEvent) == "function" then
        local okE, err = pcall(h.onEvent, event, (type(data) == "table" or typeof(data) == "buffer") and data or {}, t)
        if not okE then logOnce("evt-" .. tostring(roundId) .. tostring(err):sub(1, 30), "%s event handler error: %s", tostring(roundId), tostring(err)) end
    end
end
local function installRoundEventListener()
    if not isfn(G.Network, "Fired") then return end
    local ok, signal = gcall(G.Network.Fired, "Instancing_FireCustomFromServer")
    if not (ok and signal and type(signal.Connect) == "function") then
        local remote = RS:FindFirstChild("Network") and RS.Network:FindFirstChild("Instancing_FireCustomFromServer")
        signal = remote and remote.OnClientEvent or nil
    end
    if not signal then warnlog("could not listen to instance events, auto games cannot see the rounds") return end
    track(signal:Connect(function(instanceId, name, a, b, c, d)
        if name == "HG_Round" then
            onRoundEvent(a, b, c, d)
        elseif name == "HG_Night" and a == "saved" and type(b) == "table" then
            local st = nightState()
            if st and b.id == st.me and V.g.trickNight then
                local mem = V.g.trickNight[tostring(st.nightId)]
                if mem then mem.charmActive = false end
                log("Lucky Charm saved you (%s)", tostring(b.by))
            end
        elseif name == "HG_Night" and a == "circle" and type(b) == "table" then
            V.g.circle = { phase = b.phase, nights = b.nights, night = b.night, at = os.clock() }
        end
    end))
    log("round event listener installed")
end

local function wrapNightSelect()
    local NS = req("Library.Client.HalloweenGamesCmds.NightSelect", true)
    if not (type(NS) == "table" and type(NS.Circle) == "function") then return end
    local orig = NS.Circle
    NS.Circle = function(data, ...)
        if type(data) == "table" then V.g.circle = { phase = data.phase, nights = data.nights, night = data.night, at = os.clock() } end
        return orig(data, ...)
    end
    restoreFns[#restoreFns + 1] = function() NS.Circle = orig end
end
local function chosenNight(available)
    local want = tonumber(tostring(F.gamesNight):match("%d+"))
    local list = {}
    for _, n in ipairs(available or {}) do list[#list + 1] = tonumber(n) end
    table.sort(list)
    if #list == 0 then return want or bestZoneNumber() end
    if want then
        for _, n in ipairs(list) do if n == want then return n end end
    end
    return list[#list]
end
local function pickNight()
    local c = V.g.circle
    if not (c and c.phase == "pick") then return false end
    if os.clock() - V.g.lastPick < 4 then return false end
    V.g.lastPick = os.clock()
    local n = chosenNight(c.nights)
    if isfn(G.HGNight, "Circle") then
