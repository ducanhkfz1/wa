local function trickItemId(key)
    local tricks = type(G.HG) == "table" and G.HG.TRICKS or nil
    return type(tricks) == "table" and tricks[key] or ("Halloween Games " .. key)
end
local function trickCount(key)
    local itemId = trickItemId(key)
    local total = 0
    local save = isfn(G.Save, "Get") and gval(G.Save.Get) or nil
    local inventory = save and type(save.Inventory) == "table" and save.Inventory.Consumable
    if type(inventory) == "table" then
        for _, item in pairs(inventory) do
            if type(item) == "table" and item.id == itemId then
                total += tonumber(item._am) or 1
            end
        end
        if total > 0 then return total end
    end
    if type(G.Items) == "table" and type(G.Items.Consumable) == "function" then
        local ok, count = gcall(function() return G.Items.Consumable(itemId):CountAny() end)
        if ok and type(count) == "number" then total = math.max(total, count) end
        for tier = 1, 3 do
            local okTier, tierCount = gcall(function()
                return G.Items.Consumable(itemId):SetTier(tier):CountAny()
            end)
            if okTier and type(tierCount) == "number" then
                total = math.max(total, tierCount)
            end
        end
    end
    return total
end
local function fireTrick(key)
    if isfn(G.HGNight, "Trick") then
        local ok = pcall(G.HGNight.Trick, key)
        if ok then return true end
    end
    if isfn(G.Network, "Fire") then
        local ok, result = gcall(G.Network.Fire, "Instancing_FireCustomFromClient", currentInstanceId(), "HG_Trick", key)
        return ok == true and result ~= false
    end
    return false
end
local function sendTrick(key, reason)
    if trickCount(key) <= 0 then return false end
    if fireTrick(key) then
        state.tricksUsed += 1
        log("used %s (%s)", key, tostring(reason))
        return true
    end
    return false
end
local function trickPolicy(st)
    if not (Flags.AutoGames and F.autoTricks and st and st.phase == "play") then return end
    if os.clock() - (V.g.lastTrick or 0) < 2.5 then return end
    local nightNumber = tonumber(st.number)
    local nightId = tostring(st.nightId)
    V.g.trickNight = V.g.trickNight or {}
    local memory = V.g.trickNight[nightId]
    if not memory then
        memory = { magnet = false, charmActive = false }
        V.g.trickNight = { [nightId] = memory }
    end
    if F.trickEnabled.TreatMagnet and nightNumber == 3 and not memory.magnet then
        memory.magnet = true
        if sendTrick("TreatMagnet", "Night 3") then V.g.lastTrick = os.clock() return end
    end
    if F.trickEnabled.Lantern and nightNumber == 2 and trickCount("Lantern") > 0 then
        if sendTrick("Lantern", "Night 2") then V.g.lastTrick = os.clock() return end
    end
    local kind = type(st.config) == "table" and st.config.Kind or nil
    if F.trickEnabled.LuckyCharm and (kind == "elimination" or kind == "final" or kind == "survival") and not memory.charmActive then
        if sendTrick("LuckyCharm", "before elimination") then
            memory.charmActive = true
            V.g.lastTrick = os.clock()
        end
    end
end

