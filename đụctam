local function installStudioSpoof()
    if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function" then
        logOnce("no-studio-hook", "executor hook unavailable; using custom minigame handlers only")
        return
    end
    local oldNamecall
    local function namecallHandler(self, ...)
        if V.g.spoof and state.alive and self == RunService and getnamecallmethod() == "IsStudio" then
            return true
        end
        return oldNamecall(self, ...)
    end
    local ok, err = pcall(function()
        oldNamecall = hookmetamethod(game, "__namecall",
            type(newcclosure) == "function" and newcclosure(namecallHandler) or namecallHandler)
    end)
    if ok and type(oldNamecall) == "function" then
        V.g.spoofInstalled = true
        log("built-in autoplay hook installed")
