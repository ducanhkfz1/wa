local Recovery = {
    lastTeleportTarget = nil,
    sameTargetSince = nil,
    sameTargetLastAt = 0,
    sameTargetCount = 0,
    lastTeleportAt = 0,
    lastPosition = nil,
    stationarySince = os.clock(),
