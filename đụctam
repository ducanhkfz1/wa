local function instanceModel()
    if isfn(G.Instancing, "GetModel") then
        local model = gval(G.Instancing.GetModel)
        if typeof(model) == "Instance" then return model end
    end
    local things = workspace:FindFirstChild("__THINGS")
    local container = things and things:FindFirstChild("__INSTANCE_CONTAINER")
    local active = container and container:FindFirstChild("Active")
    local id = currentInstanceId()
    local model = active and active:FindFirstChild(id)
    if model then return model end
    local instances = things and things:FindFirstChild("Instances")
    return instances and instances:FindFirstChild("HalloweenGames") or nil
end

local function arenaModel()
    local st = nightState()
    local model = instanceModel()
    local slots = model and model:FindFirstChild("ArenaSlots")
    if not slots then return nil end
    local slot = st and slots:FindFirstChild("Slot" .. tostring(st.slot))
    local arenaName = st and st.config and st.config.Arena or (st and st.roundId) or V.g.round
    if slot and arenaName then
        local arena = slot:FindFirstChild(arenaName)
        if arena then return arena end
    end
    for _, candidate in ipairs(slots:GetChildren()) do
        if arenaName and candidate:FindFirstChild(arenaName) then
            return candidate:FindFirstChild(arenaName)
        end
        if V.g.round and candidate:FindFirstChild(V.g.round) then
            return candidate:FindFirstChild(V.g.round)
        end
    end
    return nil
end

