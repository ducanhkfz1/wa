local function teleportTo(pos)
    if typeof(pos) == "Vector3" then
        local now = os.clock()
        local sameTarget = Recovery.lastTeleportTarget
            and dist(Recovery.lastTeleportTarget, pos) <= 1.25
        local recentRepeat = now - (Recovery.sameTargetLastAt or 0) <= 25

        if sameTarget and recentRepeat then
            Recovery.sameTargetCount += 1
        else
            Recovery.sameTargetSince = now
            Recovery.sameTargetCount = 1
        end

        Recovery.lastTeleportTarget = pos
        Recovery.sameTargetLastAt = now
        Recovery.lastTeleportAt = now
    end
    local c = LocalPlayer.Character
    if c then pcall(function() c:PivotTo(CFrame.new(pos)) end) end
end

local function edgeAhead(p, flatDir)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character }
    local origin = p + flatDir * 1.4 + Vector3.new(0, 1, 0)
    local hit = workspace:Raycast(origin, Vector3.new(0, -9, 0), params)
    return hit == nil
end

