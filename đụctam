local canSetIdentity = type(setthreadidentity) == "function"
local function gcall(fn, ...)
    if type(fn) ~= "function" then return false end
    if canSetIdentity then pcall(setthreadidentity, 2) end
    local r = table.pack(pcall(fn, ...))
    if canSetIdentity then pcall(setthreadidentity, 7) end
    return table.unpack(r, 1, r.n)
end
local function gval(fn, ...) local ok, a, b, c = gcall(fn, ...) if ok then return a, b, c end return nil end
local function isfn(t, k) return type(t) == "table" and type(t[k]) == "function" end

local G = {}
local function req(path)
    for attempt = 1, 4 do
        local ok, mod = gcall(function()
            local node = ReplicatedStorage
            for seg in string.gmatch(path, "[^%.]+") do
                node = node:FindFirstChild(seg)
                if not node then return nil end
            end
            return require(node)
        end)
        if ok and mod ~= nil then return mod end
        if attempt < 4 then task.wait(0.25) end
    end
    warn("[Xuantam Halloween] module unavailable: " .. tostring(path))
    return nil
end

